}

model DebitNoteLineItem {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id @default(cuid())
  debitNoteId    String
  description    String
  hsnSac         String?
  quantity       Float        @default(1)
  rate           Float        @default(0)
  amount         Float        @default(0)
  gstRate        Float        @default(0)
  gstAmount      Float        @default(0)
  totalAmount    Float        @default(0)
  sortOrder      Int          @default(0)
  debitNote      DebitNote    @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([debitNoteId])
  @@map("debit_note_line_items")
}

enum FinancialTransactionType {
  RECEIVABLE
  PAYMENT_RECEIVED
  PAYABLE
  PAYMENT_SENT
  GST_OUTPUT
  GST_INPUT
  REFUND
  ADJUSTMENT
}

enum Role {
  ADMIN
  BOOKING
  OPERATIONS
  ACCOUNTS
  DRIVER
}

enum GstMode {
  INCLUDED
  EXCLUDED
  NONE
}

// ============================================================
// OPERATIONS — Trip Service Spine
// ============================================================

// Unified record for every bookable service inside a trip (flight, hotel,
// vehicle, activity, transfer). Dashboards, timelines, and automations
// query this single table rather than per-type tables.
model TripService {
  organizationId String        @default("org_gktravels")
  organization   Organization  @relation(fields: [organizationId], references: [id])
  id             String        @id @default(cuid())
  tripId         String
  trip           Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type           ServiceType
  status         ServiceStatus @default(DRAFT)
  serviceDate    DateTime
  startTime      String?
  endTime        String?
  supplierId     String?
  supplier       Vendor?       @relation(fields: [supplierId], references: [id])
  costPrice      Decimal       @default(0) @db.Decimal(10, 2)
  sellPrice      Decimal       @default(0) @db.Decimal(10, 2)
  details        Json          @default("{}")
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([tripId])
  @@index([supplierId])
  @@index([serviceDate])
  @@index([status])
  @@map("trip_services")
}

enum ServiceType {
  FLIGHT
  BUS
  HOTEL
  VEHICLE
  ACTIVITY
  TRANSFER
  VISA
  INSURANCE
  OTHER
}

enum ServiceStatus {
  DRAFT
  REQUESTED
  PENDING
  CONFIRMED
  COMPLETED
  VOUCHER_RECEIVED
  CANCELLED
}

// ============================================================
// OPERATIONS — Outbox / Event Rail
// ============================================================

// Every automation-relevant state change writes a row here. A background
// worker dispatches PENDING rows exactly once (idempotencyKey-deduped),
// giving automations a durable, restart-safe audit trail.
model OutboxEvent {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id @default(cuid())
  eventType      String
  payload        Json
  status         OutboxStatus @default(PENDING)
  idempotencyKey String       @unique
  scheduledFor   DateTime     @default(now())
  processedAt    DateTime?
  attempts       Int          @default(0)
  lastError      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([status, scheduledFor])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// Record of every WhatsApp/email message sent to a customer or supplier.
model MessageLog {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id @default(cuid())
  tripId         String?
  customerId     String?
  channel        String
  templateName   String?
  recipient      String
  content        String
  status         String
  sentAt         DateTime     @default(now())
  error          String?

  @@index([organizationId])
  @@index([tripId])
  @@index([customerId])
  @@map("message_logs")
}

// ============================================================
// SALES PIPELINE — Enquiry -> SalesQuote -> Confirmed Trip
//
// Named "SalesQuote"/"SalesQuoteItem" (not "Quotation") to avoid
// colliding with the existing GST Quotation/QuotationItem models,
// which remain a separate, untouched feature.
// ============================================================

model Enquiry {
  organizationId String        @default("org_gktravels")
  organization   Organization  @relation(fields: [organizationId], references: [id])
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  source         EnquirySource @default(DIRECT)
  destination    String
  departureDate  DateTime?
  returnDate     DateTime?
  pax            Int           @default(1)
  requirements   String?
  budget         Decimal?      @db.Decimal(10, 2)
  status         EnquiryStatus @default(NEW)
  assignedTo     String?
  notes          String?
  salesQuotes    SalesQuote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // ── v2 (Phase 2.5) ─────────────────────────────────────────
  enquiryNumber    String?
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  adults           Int       @default(1)
  children         Int       @default(0)
  infants          Int       @default(0)
  rooms            Int?
  origin           String?
  tripType         String?
  hotelCategory    String?
  mealPlan         String?
  flexibleDates    Boolean   @default(false)
  budgetMax        Decimal?  @db.Decimal(10, 2)
  preferences      Json      @default("{}")
  priority         String    @default("medium")
  assignedToUserId String?
  assignee         User?     @relation("EnquiryAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  lostReason       String?
  wonAt            DateTime?
  lostAt           DateTime?
  deletedAt        DateTime?

  @@unique([organizationId, enquiryNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([assignedToUserId])
  @@index([leadId])
  @@map("enquiries")
}

model SalesQuote {
  organizationId  String           @default("org_gktravels")
  organization    Organization     @relation(fields: [organizationId], references: [id])
  id              String           @id @default(cuid())
  enquiryId       String
  enquiry         Enquiry          @relation(fields: [enquiryId], references: [id])
  quoteNumber     String
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  status          SalesQuoteStatus @default(DRAFT)
  validUntil      DateTime
  lineItems       SalesQuoteItem[]
  subtotal        Decimal          @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal          @default(0) @db.Decimal(10, 2)
  notes           String?
  termsConditions String?
  sentAt          DateTime?
  viewedAt        DateTime?
  convertedAt     DateTime?
  convertedTripId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // ── v2 unified engine (Phase 2.6) ──────────────────────────
  title              String?
  version            Int                     @default(1)
  parentQuoteId      String?
  parentQuote        SalesQuote?             @relation("QuoteVersions", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  versions           SalesQuote[]            @relation("QuoteVersions")
  isCurrent          Boolean                 @default(true)
  adults             Int                     @default(1)
  children           Int                     @default(0)
  infants            Int                     @default(0)
  gstMode            GstMode                 @default(EXCLUDED)
  gstRate            Decimal                 @default(5) @db.Decimal(5, 2)
  taxableAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  costAmount         Decimal                 @default(0) @db.Decimal(12, 2)
  inclusions         String?
  exclusions         String?
  paymentPolicy      String?
  cancellationPolicy String?
  approvalStatus     String                  @default("NOT_REQUIRED")
  approvalComment    String?
  approvedBy         String?
  approvedAt         DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  totalsCache        Json                    @default("{}")
  createdByUserId    String?
  deletedAt          DateTime?
  optionGroups       SalesQuoteOptionGroup[]
  parties            SalesQuoteParty[]
  contracts          BookingContract[]

  @@unique([organizationId, quoteNumber])
  @@index([organizationId])
  @@index([enquiryId])
  @@index([customerId])
  @@index([status])
  @@index([parentQuoteId])
  @@map("sales_quotes")
}

enum PricingBasis {
  PER_PERSON
  PER_UNIT
  PER_ROOM
  PER_GROUP
}

// Alternatives inside one quotation ("Flight options": three items, one selected).
model SalesQuoteOptionGroup {
  id             String           @id @default(cuid())
  organizationId String           @default("org_gktravels")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  salesQuoteId   String
  salesQuote     SalesQuote       @relation(fields: [salesQuoteId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int              @default(0)
  items          SalesQuoteItem[]

  @@index([organizationId])
  @@index([salesQuoteId])
  @@map("sales_quote_option_groups")
}

// A family or sub-group inside a group quotation; items can be allocated to it.
model SalesQuoteParty {
  id             String           @id @default(cuid())
  organizationId String           @default("org_gktravels")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  salesQuoteId   String
  salesQuote     SalesQuote       @relation(fields: [salesQuoteId], references: [id], onDelete: Cascade)
  name           String
  adults         Int              @default(1)
  children       Int              @default(0)
  infants        Int              @default(0)
  travellerIds   Json             @default("[]")
  sortOrder      Int              @default(0)
  items          SalesQuoteItem[]

  @@index([organizationId])
  @@index([salesQuoteId])
  @@map("sales_quote_parties")
}

enum ContractStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// The commercial agreement created when a quotation is accepted: one per
// quotation, or one per party when the customer wants family-wise billing.
// It owns the payment schedule and points at the legacy Trip so operations
// and finance screens keep working until Phase 3/4 replace them.
model BookingContract {
  id                 String                @id @default(cuid())
  organizationId     String                @default("org_gktravels")
  organization       Organization          @relation(fields: [organizationId], references: [id])
  contractNumber     String
  status             ContractStatus        @default(CONFIRMED)
  salesQuoteId       String
  salesQuote         SalesQuote            @relation(fields: [salesQuoteId], references: [id])
  enquiryId          String
  customerId         String
  customer           Customer              @relation(fields: [customerId], references: [id])
  partyId            String?
  partyName          String?
  tripId             String?
  trip               Trip?                 @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripTravellers     TripTraveller[]
  destination        String
  departureDate      DateTime?
  returnDate         DateTime?
  adults             Int                   @default(1)
  children           Int                   @default(0)
  infants            Int                   @default(0)
  travellerIds       Json                  @default("[]")
  currency           String                @default("INR")
  subtotal           Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal               @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal               @default(0) @db.Decimal(12, 2)
  costAmount         Decimal               @default(0) @db.Decimal(12, 2)
  gstMode            GstMode               @default(EXCLUDED)
  gstRate            Decimal               @default(5) @db.Decimal(5, 2)
  paymentPolicy      String?
  cancellationPolicy String?
  notes              String?
  cancelledAt        DateTime?
  cancellationReason String?
  completedAt        DateTime?
  createdByUserId    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  schedule           PaymentScheduleItem[]
  hotelBookings      HotelBooking[]
  vehicleAssignments VehicleAssignment[]
  activityBookings   ActivityBooking[]
  tickets            Ticket[]
  ledgerEntries      LedgerTransaction[]
  receipts           CustomerReceipt[]
  vendorBills        VendorBill[]
  expenses           Expense[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@index([tripId])
  @@index([salesQuoteId])
  @@index([customerId])
  @@index([status])
  @@map("booking_contracts")
}

model PaymentScheduleItem {
  id             String          @id @default(cuid())
  organizationId String          @default("org_gktravels")
  organization   Organization    @relation(fields: [organizationId], references: [id])
  contractId     String
  contract       BookingContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  seq            Int
  label          String
  dueDate        DateTime
  amount         Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())

  @@unique([contractId, seq])
  @@index([organizationId])
  @@index([dueDate])
  @@map("payment_schedule_items")
}

// Per-band (adult/child/infant) cost and sell for PER_PERSON items.
model SalesQuoteItemRate {
  id             String         @id @default(cuid())
  organizationId String         @default("org_gktravels")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  itemId         String
  item           SalesQuoteItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  band           String
  count          Int            @default(0)
  costPrice      Decimal        @default(0) @db.Decimal(12, 2)
  sellPrice      Decimal        @default(0) @db.Decimal(12, 2)

  @@unique([itemId, band])
  @@index([organizationId])
  @@map("sales_quote_item_rates")
}

model SalesQuoteItem {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id @default(cuid())
  salesQuoteId   String
  salesQuote     SalesQuote   @relation(fields: [salesQuoteId], references: [id], onDelete: Cascade)
  serviceType    ServiceType
  description    String
  supplierId     String?
  supplier       Vendor?      @relation(fields: [supplierId], references: [id])
  costPrice      Decimal      @db.Decimal(10, 2)
  markup         Decimal      @default(0) @db.Decimal(10, 2)
  sellPrice      Decimal      @db.Decimal(10, 2)
  quantity       Int          @default(1)
  unit           String       @default("per person")
  details        Json         @default("{}")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  // ── v2 (Phase 2.6) ─────────────────────────────────────────
  pricingBasis     PricingBasis           @default(PER_UNIT)
  nights           Int?
  serviceDate      DateTime?
  taxRate          Decimal?               @db.Decimal(5, 2)
  optionGroupId    String?
  optionGroup      SalesQuoteOptionGroup? @relation(fields: [optionGroupId], references: [id], onDelete: SetNull)
  isSelectedOption Boolean                @default(true)
  partyId          String?
  party            SalesQuoteParty?       @relation(fields: [partyId], references: [id], onDelete: SetNull)
  customerNote     String?
  internalNote     String?
  rates            SalesQuoteItemRate[]

  @@index([organizationId])
  @@index([salesQuoteId])
  @@index([supplierId])
  @@index([optionGroupId])
  @@index([partyId])
  @@map("sales_quote_items")
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum EnquirySource {
  DIRECT
  WHATSAPP
  PHONE
  EMAIL
  REFERRAL
  WEBSITE
}

enum SalesQuoteStatus {
  DRAFT
  SENT
  VIEWED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
}

// ============================================================
// OPERATIONS MASTERS (Phase 3.1): hotels, fleet, activities
// ============================================================

enum VendorKind {
  DMC
  AIR_CONSOLIDATOR
  HOTEL
  TRANSPORT
  ACTIVITY
  GUIDE
  VISA
  INSURANCE
  RAIL_BUS_AGENT
  OTHER
}

enum MealPlan {
  EP
  CP
  MAP
  AP
  AI
}

enum VehicleOwnership {
  OWNED
  VENDOR
}

model Hotel {
  id             String          @id @default(cuid())
  organizationId String          @default("org_gktravels")
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  city           String
  state          String?
  category       String?
  vendorId       String?
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  address        String?
  phone          String?
  email          String?
  gstin          String?
  checkInTime    String?
  checkOutTime   String?
  amenities      Json            @default("[]")
  notes          String?
  isActive       Boolean         @default(true)
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  roomTypes      HotelRoomType[]
  bookings       HotelBooking[]

  @@index([organizationId, city])
  @@index([organizationId, name])
  @@index([vendorId])
  @@map("hotels")
}

model HotelRoomType {
  id             String         @id @default(cuid())
  organizationId String         @default("org_gktravels")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  hotelId        String
  hotel          Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name           String
  maxAdults      Int            @default(2)
  maxChildren    Int            @default(1)
  mealPlans      Json           @default("[\"CP\"]")
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  rates          HotelRate[]
  bookings       HotelBooking[]

  @@unique([hotelId, name])
  @@index([organizationId])
  @@map("hotel_room_types")
}

// One season per row; seasons for the same room type and meal plan never
// overlap (src/shared/calc/hotelRates.ts, enforced by the service).
model HotelRate {
  id             String        @id @default(cuid())
  organizationId String        @default("org_gktravels")
  organization   Organization  @relation(fields: [organizationId], references: [id])
  roomTypeId     String
  roomType       HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  mealPlan       MealPlan
  validFrom      DateTime      @db.Date
  validTo        DateTime      @db.Date
  costPerNight   Decimal       @db.Decimal(12, 2)
  sellPerNight   Decimal?      @db.Decimal(12, 2)
  extraAdult     Decimal?      @db.Decimal(12, 2)
  extraChild     Decimal?      @db.Decimal(12, 2)
  gstRatePct     Decimal?      @db.Decimal(5, 2)
  label          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([roomTypeId, mealPlan, validFrom])
  @@map("hotel_rates")
}

model Vehicle {
  id              String              @id @default(cuid())
  organizationId  String              @default("org_gktravels")
  organization    Organization        @relation(fields: [organizationId], references: [id])
  registrationNo  String
  type            String
  make            String?
  model           String?
  seats           Int                 @default(4)
  ownership       VehicleOwnership    @default(OWNED)
  vendorId        String?
  vendor          Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  defaultDriverId String?
  defaultDriver   Driver?             @relation("VehicleDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: SetNull)
  insuranceExpiry DateTime?           @db.Date
  permitExpiry    DateTime?           @db.Date
  fitnessExpiry   DateTime?           @db.Date
  pucExpiry       DateTime?           @db.Date
  notes           String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  assignments     VehicleAssignment[]

  @@unique([organizationId, registrationNo])
  @@index([vendorId])
  @@map("vehicles")
}

model Driver {
  id                 String              @id @default(cuid())
  organizationId     String              @default("org_gktravels")
  organization       Organization        @relation(fields: [organizationId], references: [id])
  name               String
  phone              String
  phoneNormalized    String?
  altPhone           String?
  vendorId           String?
  vendor             Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  // App login for the driver view (role DRIVER); one user per driver.
  userId             String?             @unique
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  licenceNo          String?
  licenceExpiry      DateTime?           @db.Date
  languages          Json                @default("[]")
  address            String?
  emergencyContact   String?
  notes              String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  defaultForVehicles Vehicle[]           @relation("VehicleDefaultDriver")
  assignments        VehicleAssignment[]

  @@index([organizationId, phoneNormalized])
  @@index([vendorId])
  @@map("drivers")
}

model Activity {
  id              String            @id @default(cuid())
  organizationId  String            @default("org_gktravels")
  organization    Organization      @relation(fields: [organizationId], references: [id])
  name            String
  city            String
  category        String?
  vendorId        String?
  vendor          Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  durationMinutes Int?
  description     String?
  inclusions      String?
  costAdult       Decimal?          @db.Decimal(12, 2)
  costChild       Decimal?          @db.Decimal(12, 2)
  sellAdult       Decimal?          @db.Decimal(12, 2)
  sellChild       Decimal?          @db.Decimal(12, 2)
  minPax          Int?
  maxPax          Int?
  notes           String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bookings        ActivityBooking[]

  @@index([organizationId, city])
  @@index([vendorId])
  @@map("activities")
}

// ============================================================
// TRIP OPERATIONS (Phase 3.2): hotel bookings, vehicle assignments,
// activity bookings. Money in Decimal; cost/sell redacted by role.
// ============================================================

enum TripStage {
  PLANNING
  CONFIRMING
  READY
  ONGOING
  COMPLETED
  CANCELLED
}

enum OpsStatus {
  REQUESTED
  ON_HOLD
  CONFIRMED
  CANCELLED
}

enum AssignmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DriverDutyStatus {
  ASSIGNED
  ACKNOWLEDGED
  STARTED
  ARRIVED
  ON_BOARD
  COMPLETED
  ISSUE
}

model HotelBooking {
  id              String           @id @default(cuid())
  organizationId  String           @default("org_gktravels")
  organization    Organization     @relation(fields: [organizationId], references: [id])
  tripId          String
  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        BookingContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  hotelId         String?
  hotel           Hotel?           @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  hotelName       String
  city            String?
  roomTypeId      String?
  roomType        HotelRoomType?   @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  roomTypeName    String?
  mealPlan        MealPlan?
  checkIn         DateTime         @db.Date
  checkOut        DateTime         @db.Date
  rooms           Int              @default(1)
  adults          Int              @default(2)
  children        Int              @default(0)
  travellerIds    Json             @default("[]")
  status          OpsStatus        @default(REQUESTED)
  confirmationNo  String?
  vendorId        String?
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  costAmount      Decimal          @default(0) @db.Decimal(12, 2)
  sellAmount      Decimal          @default(0) @db.Decimal(12, 2)
  customerNotes   String?
  internalNotes   String?
  requestedAt     DateTime?
  confirmedAt     DateTime?
  confirmedById   String?
  cancelledAt     DateTime?
  cancelReason    String?
  legacyBookingId String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, legacyBookingId])
  @@index([tripId])
  @@index([organizationId, checkIn])
  @@index([organizationId, status])
  @@map("hotel_bookings")
}

model VehicleAssignment {
  id              String           @id @default(cuid())
  organizationId  String           @default("org_gktravels")
  organization    Organization     @relation(fields: [organizationId], references: [id])
  tripId          String
  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        BookingContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  vehicleId       String?
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId        String?
  driver          Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vehicleType     String?
  seatsRequired   Int?
  vehicleRegNo    String?
  driverName      String?
  driverPhone     String?
  startAt         DateTime
  endAt           DateTime
  pickupPoint     String?
  dropPoint       String?
  route           String?
  pax             Int              @default(0)
  status          AssignmentStatus @default(REQUESTED)
  driverStatus    DriverDutyStatus @default(ASSIGNED)
  driverStatusAt  DateTime?
  driverNote      String?
  confirmationNo  String?
  costAmount      Decimal          @default(0) @db.Decimal(12, 2)
  sellAmount      Decimal          @default(0) @db.Decimal(12, 2)
  customerNotes   String?
  internalNotes   String?
  cancelledAt     DateTime?
  cancelReason    String?
  legacyBookingId String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, legacyBookingId])
  @@index([tripId])
  @@index([vehicleId, startAt])
  @@index([driverId, startAt])
  @@index([organizationId, startAt])
  @@map("vehicle_assignments")
}

model ActivityBooking {
  id              String           @id @default(cuid())
  organizationId  String           @default("org_gktravels")
  organization    Organization     @relation(fields: [organizationId], references: [id])
  tripId          String
  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        BookingContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  activityId      String?
  activity        Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  name            String
  city            String?
  date            DateTime         @db.Date
  time            String?
  adults          Int              @default(1)
  children        Int              @default(0)
  status          OpsStatus        @default(REQUESTED)
  confirmationNo  String?
  vendorId        String?
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  costAmount      Decimal          @default(0) @db.Decimal(12, 2)
  sellAmount      Decimal          @default(0) @db.Decimal(12, 2)
  customerNotes   String?
  internalNotes   String?
  confirmedAt     DateTime?
  cancelReason    String?
  legacyBookingId String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, legacyBookingId])
  @@index([tripId])
  @@index([organizationId, date])
  @@map("activity_bookings")
}

// A rate the business charges, with the day it starts. Tax rates are
// configuration, never constants in code: a change is a new row, and the
// old one stays so past invoices still explain themselves.
model TaxRule {
  id             String       @id @default(cuid())
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// Catalogue code from calc/tax.ts, e.g. GST_TOUR_PACKAGE.
  code           String
  rate           Decimal      @db.Decimal(5, 2)
  /// Yearly limit per customer before it applies (TCS); zero for GST.
  threshold      Decimal      @default(0) @db.Decimal(12, 2)
  enabled        Boolean      @default(true)
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  note           String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code, effectiveFrom])
  @@index([organizationId, code])
  @@map("tax_rules")
}

// Money spent directly (fuel, tolls, food on the road, tips, office costs)
// rather than against a supplier bill. paidBy STAFF means someone paid from
// their own pocket and is owed it back until a StaffReimbursement settles it.
model Expense {
  id                  String           @id
  organizationId      String           @default("org_gktravels")
  organization        Organization     @relation(fields: [organizationId], references: [id])
  date                DateTime         @db.Date
  category            String
  amount              Decimal          @db.Decimal(12, 2)
  gstAmount           Decimal          @default(0) @db.Decimal(12, 2)
  paidBy              String
  paidByUserId        String?
  paidByUser          User?            @relation("ExpensePaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  tripId              String?
  trip                Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)
  contractId          String?
  contract            BookingContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  vendorId            String?
  vendor              Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  description         String
  notes               String?
  documentId          String?
  status              String           @default("POSTED")
  ledgerTransactionId String?          @unique
  cancelledAt         DateTime?
  cancelReason        String?
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([organizationId, date])
  @@index([tripId])
  @@index([paidByUserId])
  @@index([category])
  @@map("expenses")
}

model StaffReimbursement {
  id                  String       @id
  organizationId      String       @default("org_gktravels")
  organization        Organization @relation(fields: [organizationId], references: [id])
  userId              String
  user                User         @relation("StaffReimbursed", fields: [userId], references: [id])
  amount              Decimal      @db.Decimal(12, 2)
  mode                String
  paidAt              DateTime     @db.Date
  reference           String?
  status              String       @default("POSTED")
  ledgerTransactionId String?      @unique
  createdById         String?
  createdAt           DateTime     @default(now())

  @@index([organizationId, paidAt])
  @@index([userId])
  @@map("staff_reimbursements")
}

// What a supplier has charged (hotel, transporter, consolidator, activity
// provider) and the money paid against it. A payment with no bill is an
// advance and sits in "Advances to suppliers" until a bill arrives.
model VendorBill {
  id                  String            @id
  organizationId      String            @default("org_gktravels")
  organization        Organization      @relation(fields: [organizationId], references: [id])
  vendorId            String
  vendor              Vendor            @relation(fields: [vendorId], references: [id])
  billNumber          String
  billDate            DateTime          @db.Date
  dueDate             DateTime?         @db.Date
  /// HOTEL / TRANSPORT / TICKET / ACTIVITY / OTHER_TRIP / OFFICE — decides the expense account.
  category            String
  amount              Decimal           @db.Decimal(12, 2)
  gstAmount           Decimal           @default(0) @db.Decimal(12, 2)
  status              String            @default("OPEN")
  tripId              String?
  trip                Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  contractId          String?
  contract            BookingContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  description         String?
  notes               String?
  documentId          String?
  ledgerTransactionId String?           @unique
  cancelledAt         DateTime?
  cancelReason        String?
  /// Set when the row came from the classic vendor payables screen.
  legacyPayableId     String?
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  payments            VendorPaymentV2[]

  @@unique([organizationId, legacyPayableId])
  @@index([organizationId, billDate])
  @@index([vendorId])
  @@index([tripId])
  @@index([status])
  @@map("vendor_bills")
}

model VendorPaymentV2 {
  id                  String       @id
  organizationId      String       @default("org_gktravels")
  organization        Organization @relation(fields: [organizationId], references: [id])
  vendorId            String
  vendor              Vendor       @relation(fields: [vendorId], references: [id])
  billId              String?
  bill                VendorBill?  @relation(fields: [billId], references: [id], onDelete: SetNull)
  tripId              String?
  trip                Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  amount              Decimal      @db.Decimal(12, 2)
  mode                String
  paidAt              DateTime     @db.Date
  reference           String?
  notes               String?
  status              String       @default("POSTED")
  ledgerTransactionId String?      @unique
  cancelledAt         DateTime?
  cancelReason        String?
  legacyPaymentId     String?
  createdById         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([organizationId, legacyPaymentId])
  @@index([organizationId, paidAt])
  @@index([vendorId])
  @@index([billId])
  @@map("vendor_bill_payments")
}

// Money received from (or refunded to) a customer. Held against the family
// party's booking contract where there is one, so several families on one
// tour keep separate balances. Every row has a ledger posting; cancelling
// reverses the posting and keeps the row.
enum ReceiptKind {
  RECEIPT
  REFUND
}

enum ReceiptMode {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  GATEWAY
  /// Classic rows whose method was never recorded; they sit in "Unsorted receipts" until someone says where the money went.
  OTHER
}

model CustomerReceipt {
  id                  String           @id
  organizationId      String           @default("org_gktravels")
  organization        Organization     @relation(fields: [organizationId], references: [id])
  kind                ReceiptKind      @default(RECEIPT)
  status              String           @default("POSTED")
  contractId          String?
  contract            BookingContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  tripId              String?
  trip                Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)
  customerId          String?
  customer            Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount              Decimal          @db.Decimal(12, 2)
  mode                ReceiptMode
  receivedAt          DateTime         @db.Date
  reference           String?
  notes               String?
  ledgerTransactionId String?          @unique
  cancelledAt         DateTime?
  cancelReason        String?
  /// Set when the row came from the classic payments table, so the import never doubles up.
  legacyPaymentId     String?
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([organizationId, legacyPaymentId])
  @@index([organizationId, receivedAt])
  @@index([contractId])
  @@index([tripId])
  @@index([customerId])
  @@map("customer_receipts")
}

// ============================================================
// LEDGER (Phase 4): double-entry books. Nothing posted is edited or
// deleted; a mistake is corrected with a reversal that mirrors it.
// ============================================================

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

model LedgerAccount {
  id             String       @id @default(cuid())
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  type           AccountType
  group          String       @default("Other")
  description    String?
  /// Seeded accounts the posting services refer to by code; they cannot be deleted.
  isSystem       Boolean      @default(true)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lines          LedgerLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String             @id @default(cuid())
  organizationId String             @default("org_gktravels")
  organization   Organization       @relation(fields: [organizationId], references: [id])
  displayNumber  String
  date           DateTime           @db.Date
  narration      String
  /// What caused the posting: receipt, refund, vendor_bill, vendor_payment, expense, invoice, manual, reversal.
  sourceType     String
  sourceId       String?
  tripId         String?
  trip           Trip?              @relation(fields: [tripId], references: [id], onDelete: SetNull)
  contractId     String?
  contract       BookingContract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendorId       String?
  vendor         Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  reversalOfId   String?            @unique
  reversalOf     LedgerTransaction? @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy     LedgerTransaction? @relation("LedgerReversal")
  reversalReason String?
  postedAt       DateTime           @default(now())
  createdById    String?
  source         String             @default("HUMAN")
  lines          LedgerLine[]

  @@unique([organizationId, displayNumber])
  @@index([organizationId, date])
  @@index([sourceType, sourceId])
  @@index([tripId])
  @@index([contractId])
  @@map("ledger_transactions")
}

model LedgerLine {
  id             String            @id @default(cuid())
  organizationId String            @default("org_gktravels")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  transactionId  String
  transaction    LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId      String
  account        LedgerAccount     @relation(fields: [accountId], references: [id])
  /// Account code at posting time, so a renamed account still reads correctly.
  accountCode    String
  seq            Int               @default(0)
  debit          Decimal           @default(0) @db.Decimal(14, 2)
  credit         Decimal           @default(0) @db.Decimal(14, 2)
  description    String?
  customerId     String?
  vendorId       String?
  tripId         String?
  contractId     String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, accountCode])
  @@index([transactionId])
  @@index([tripId])
  @@map("ledger_lines")
}

// ============================================================
// TICKETS (Phase 3.3): ticket -> segments -> passenger rows
// ============================================================

enum TicketMode {
  FLIGHT
  TRAIN
  BUS
}

enum TicketStatus {
  REQUESTED
  ON_HOLD
  CONFIRMED
  PARTIAL
  WAITLISTED
  RAC
  CANCELLED
}

enum PassengerStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  RAC
  CANCELLED
}

model Ticket {
  id               String            @id @default(cuid())
  organizationId   String            @default("org_gktravels")
  organization     Organization      @relation(fields: [organizationId], references: [id])
  displayNumber    String?
  tripId           String?
  trip             Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  contractId       String?
  contract         BookingContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mode             TicketMode
  status           TicketStatus      @default(REQUESTED)
  pnr              String?
  carrier          String?
  bookingRef       String?
  quota            String?
  travelClass      String?
  vendorId         String?
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  baseFare         Decimal           @default(0) @db.Decimal(12, 2)
  taxes            Decimal           @default(0) @db.Decimal(12, 2)
  otherCharges     Decimal           @default(0) @db.Decimal(12, 2)
  serviceFee       Decimal           @default(0) @db.Decimal(12, 2)
  serviceFeeGstPct Decimal?          @db.Decimal(5, 2)
  serviceFeeGst    Decimal           @default(0) @db.Decimal(12, 2)
  totalFare        Decimal           @default(0) @db.Decimal(12, 2)
  costAmount       Decimal           @default(0) @db.Decimal(12, 2)
  currency         String            @default("INR")
  sourceDocumentId String?
  sourceDocument   Document?         @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  chartPrepared    Boolean           @default(false)
  chartCheckedAt   DateTime?
  bookedAt         DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  customerNotes    String?
  internalNotes    String?
  legacyBookingId  String?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  segments         TicketSegment[]
  passengers       TicketPassenger[]

  @@unique([organizationId, displayNumber])
  @@unique([organizationId, legacyBookingId])
  @@index([tripId])
  @@index([customerId])
  @@index([organizationId, pnr])
  @@index([organizationId, status])
  @@map("tickets")
}

// One leg: its own number, class, times and boarding / dropping points.
model TicketSegment {
  id             String            @id @default(cuid())
  organizationId String            @default("org_gktravels")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  ticketId       String
  ticket         Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  seq            Int
  carrierNumber  String?
  carrierName    String?
  fromCode       String?
  fromName       String
  toCode         String?
  toName         String
  departAt       DateTime?
  arriveAt       DateTime?
  travelClass    String?
  boardingPoint  String?
  droppingPoint  String?
  terminal       String?
  platform       String?
  baggage        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  passengers     TicketPassenger[]

  @@unique([ticketId, seq])
  @@index([organizationId, departAt])
  @@map("ticket_segments")
}

// One passenger on one segment (paxIndex groups a person across segments).
model TicketPassenger {
  id               String          @id @default(cuid())
  organizationId   String          @default("org_gktravels")
  organization     Organization    @relation(fields: [organizationId], references: [id])
  ticketId         String
  ticket           Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  segmentId        String
  segment          TicketSegment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  paxIndex         Int
  travellerId      String?
  traveller        Traveller?      @relation(fields: [travellerId], references: [id], onDelete: SetNull)
  name             String
  paxType          String          @default("ADULT")
  age              Int?
  gender           String?
  status           PassengerStatus @default(PENDING)
  bookingStatus    String?
  currentStatus    String?
  waitlistPosition Int?
  coach            String?
  seat             String?
  berth            String?
  ticketNumber     String?
  boardingPoint    String?
  fare             Decimal?        @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([segmentId, paxIndex])
  @@index([ticketId])
  @@index([travellerId])
  @@index([organizationId])
  @@map("ticket_passengers")
}

// Where a group tour collects its passengers (e.g. Karad, Sangli, Miraj, Belagavi), in route order.
model TripPickupPoint {
  id             String          @id @default(cuid())
  organizationId String          @default("org_gktravels")
  organization   Organization    @relation(fields: [organizationId], references: [id])
  tripId         String
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seq            Int
  name           String
  address        String?
  landmark       String?
  pickupAt       DateTime?
  contactName    String?
  contactPhone   String?
  mapUrl         String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  travellers     TripTraveller[]

  @@index([tripId])
  @@index([organizationId])
  @@map("trip_pickup_points")
}

// A message the office sends again and again, with {{placeholders}} filled
// from the record it is sent about. System templates are seeded per
// organisation and can be edited or switched off, never deleted.
// WhatsApp outside a conversation needs a template Meta has approved:
// `metaTemplateName` / `metaLanguage` name it, and the placeholders are sent
// as its parameters in the order they appear in the body.
model MessageTemplate {
  id               String       @id @default(cuid())
  organizationId   String       @default("org_gktravels")
  organization     Organization @relation(fields: [organizationId], references: [id])
  key              String
  channel          String
  name             String
  purpose          String?
  subject          String?
  body             String
  metaTemplateName String?
  metaLanguage     String       @default("en")
  isSystem         Boolean      @default(false)
  enabled          Boolean      @default(true)
  updatedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, key, channel])
  @@index([organizationId])
  @@map("message_templates")
}

// Something a person should know about, shown under the bell. One row per
// person; `dedupeKey` stops the same thing being announced twice.
model Notification {
  id             String       @id @default(cuid())
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  type           String
  title          String
  body           String?
  link           String?
  entityType     String?
  entityId       String?
  dedupeKey      String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId, dedupeKey])
  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

// An automation the owner can see and switch: a trigger from the catalogue
// (calc/automation.ts) and what to do. Only events after `enabledAt` are
// acted on.
model AutomationRule {
  id             String          @id @default(cuid())
  organizationId String          @default("org_gktravels")
  organization   Organization    @relation(fields: [organizationId], references: [id])
  key            String
  trigger        String
  name           String
  params         Json            @default("{}")
  actions        Json
  enabled        Boolean         @default(false)
  enabledAt      DateTime?
  isSystem       Boolean         @default(true)
  updatedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  runs           AutomationRun[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("automation_rules")
}

// One time a rule acted on one event, with what each action did. The
// (rule, eventKey) pair is unique, so an event is never acted on twice.
model AutomationRun {
  id             String         @id @default(cuid())
  organizationId String         @default("org_gktravels")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  ruleId         String
  rule           AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventKey       String
  entityType     String?
  entityId       String?
  /// DONE · SKIPPED · FAILED
  status         String
  summary        String
  outcomes       Json
  createdAt      DateTime       @default(now())

  @@unique([ruleId, eventKey])
  @@index([organizationId, ruleId, createdAt])
  @@map("automation_runs")
}

// A private link to a customer's own page (Phase 8). Only the SHA-256 of the
// token is kept; the link is shown once when it is made. It lapses, can be
// revoked, and may also need a one-time code sent to the customer.
model PortalAccess {
  id             String       @id @default(cuid())
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String
  tokenHash      String       @unique
  label          String?
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedById    String?
  requireCode    Boolean      @default(false)
  /// WHATSAPP | EMAIL — how the one-time code is sent.
  codeChannel    String?
  codeHash       String?
  codeExpiresAt  DateTime?
  codeSentAt     DateTime?
  codeAttempts   Int          @default(0)
  lastUsedAt     DateTime?
  useCount       Int          @default(0)
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, customerId])
  @@map("portal_access")
}

// What a customer said about a trip, from their page. One per customer per trip; they may change it.
model Feedback {
  id             String       @id @default(cuid())
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  tripId         String
  customerId     String
  rating         Int
  comments       String?
  portalAccessId String?
  submittedAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, tripId, customerId])
  @@index([organizationId, tripId])
  @@map("feedback")
}
