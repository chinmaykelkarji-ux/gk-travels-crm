generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy ──────────────────────────────────────────────────
// One row per travel company. Every business table carries organizationId
// (server/src/core/tenant.ts scopes every query to the current one). The
// default "org_gktravels" keeps the single-tenant deployment working and is
// removed once the platform phase adds organisation onboarding.
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  legalName String?
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  customers             Customer[]
  leads                 Lead[]
  trips                 Trip[]
  bookings              Booking[]
  payments              Payment[]
  receivables           Receivable[]
  receivableEntrys      ReceivableEntry[]
  financialTransactions FinancialTransaction[]
  tasks                 Task[]
  activityLogs          ActivityLog[]
  communications        Communication[]
  reminders             Reminder[]
  vendors               Vendor[]
  vendorPayments        VendorPayment[]
  quotations            Quotation[]
  quotationItems        QuotationItem[]
  itinerarys            Itinerary[]
  itineraryDays         ItineraryDay[]
  vouchers              Voucher[]
  passengers            Traveller[]
  companySettingss      CompanySettings[]
  numberingSequences    NumberingSequence[]
  invoices              Invoice[]
  invoiceLineItems      InvoiceLineItem[]
  creditNotes           CreditNote[]
  creditNoteLineItems   CreditNoteLineItem[]
  debitNotes            DebitNote[]
  debitNoteLineItems    DebitNoteLineItem[]
  tripServices          TripService[]
  outboxEvents          OutboxEvent[]
  messageLogs           MessageLog[]
  enquirys              Enquiry[]
  salesQuotes           SalesQuote[]
  salesQuoteItems       SalesQuoteItem[]

  sessions               Session[]
  jobs                   Job[]
  documents              Document[]
  documentLinks          DocumentLink[]
  customerRelationships  CustomerRelationship[]
  tripTravellers         TripTraveller[]
  salesQuoteOptionGroups SalesQuoteOptionGroup[]
  salesQuoteParties      SalesQuoteParty[]
  salesQuoteItemRates    SalesQuoteItemRate[]
  bookingContracts       BookingContract[]
  paymentScheduleItems   PaymentScheduleItem[]
  hotels                 Hotel[]
  hotelRoomTypes         HotelRoomType[]
  hotelRates             HotelRate[]
  vehicles               Vehicle[]
  drivers                Driver[]
  activities             Activity[]
  hotelBookings          HotelBooking[]
  vehicleAssignments     VehicleAssignment[]
  activityBookings       ActivityBooking[]
  tickets                Ticket[]
  ticketSegments         TicketSegment[]
  ticketPassengers       TicketPassenger[]

  @@map("organizations")
}

model User {
  organizationId    String       @default("org_gktravels")
  organization      Organization @relation(fields: [organizationId], references: [id])
  id                String       @id @default(cuid())
  email             String       @unique
  passwordHash      String
  name              String
  role              Role         @default(ADMIN)
  isActive          Boolean      @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  sessions          Session[]
  assignedLeads     Lead[]       @relation("LeadAssignee")
  assignedEnquiries Enquiry[]    @relation("EnquiryAssignee")
  driverProfile     Driver?

  @@index([organizationId])
  @@map("users")
}

// ── Server-side sessions (core/sessions.ts) ─────────────────
// One row per sign-in. The JWT cookie names the row (sid); revoking it takes
// effect on the next request, which is what deactivation, role changes and
// password resets rely on.
model Session {
  id             String       @id @default(cuid())
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  ip             String?
  userAgent      String?

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("sessions")
}

// ── Background jobs (core/jobs.ts) ───────────────────────────
enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Job {
  id             String       @id @default(cuid())
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String
  payload        Json         @default("{}")
  status         JobStatus    @default(PENDING)
  priority       Int          @default(0)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  runAfter       DateTime     @default(now())
  lockedUntil    DateTime?
  lockedBy       String?
  startedAt      DateTime?
  finishedAt     DateTime?
  lastError      String?
  result         Json?
  idempotencyKey String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([status, runAfter])
  @@index([organizationId, status])
  @@index([type])
  @@map("jobs")
}

// ── Documents (core/storage.ts, routes/v2/documents.ts) ──────
enum DocumentType {
  FLIGHT_TICKET
  TRAIN_TICKET
  BUS_TICKET
  HOTEL_CONFIRMATION
  ACTIVITY_VOUCHER
  VEHICLE_VOUCHER
  SUPPLIER_INVOICE
  CUSTOMER_INVOICE
  PAYMENT_RECEIPT
  INSURANCE
  PASSPORT
  VISA
  ID_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  EXTRACTED
  NEEDS_REVIEW
  LINKED
  FAILED
}

model Document {
  id                String         @id @default(cuid())
  organizationId    String         @default("org_gktravels")
  organization      Organization   @relation(fields: [organizationId], references: [id])
  type              DocumentType   @default(OTHER)
  status            DocumentStatus @default(PENDING_UPLOAD)
  title             String
  fileName          String
  mimeType          String
  sizeBytes         Int
  sha256            String?
  storageKey        String         @unique
  uploadedById      String?
  uploadedAt        DateTime?
  expiresAt         DateTime?
  version           Int            @default(1)
  previousVersionId String?
  customerVisible   Boolean        @default(false)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  links             DocumentLink[]
  tickets           Ticket[]

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([uploadedById])
  @@map("documents")
}

model DocumentLink {
  id             String       @id @default(cuid())
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  role           String?
  createdAt      DateTime     @default(now())

  @@unique([documentId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@map("document_links")
}

model Customer {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id
  customerNumber Int          @unique @default(autoincrement())
  name           String
  phone          String
  altPhone       String?
  email          String?
  address        String?
  city           String?
  preferences    Json         @default("{}")
  notes          String?
  tripIds        Json         @default("[]")
  documents      Json         @default("[]")
  createdDate    String
  sourceLeadId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  billingAddress String?
  companyName    String?
  gstNumber      String?
  gstRegistered  Boolean      @default(false)
  state          String?

  // Identity documents (columns added by migration 20260917000000). Aadhaar is
  // deliberately excluded: UIDAI rules restrict retention and nothing in the
  // product collects it.
  passportNo      String?
  passportExpiry  String?
  passportCountry String?
  panNumber       String?
  // Sealed passport number (core/identity.ts). passportNo above is legacy
  // plaintext: never written, cleared by the identity.encrypt-legacy job.
  passportNoEnc   String?
  passportNoHash  String?
  passportNoLast4 String?

  // ── v2 (Phase 2.2) ─────────────────────────────────────────
  phoneNormalized      String?
  type                 CustomerType           @default(INDIVIDUAL)
  source               String?
  tags                 Json                   @default("[]")
  referredByCustomerId String?
  referredBy           Customer?              @relation("CustomerReferral", fields: [referredByCustomerId], references: [id], onDelete: SetNull)
  referrals            Customer[]             @relation("CustomerReferral")
  mergedIntoId         String?
  deletedAt            DateTime?
  relationships        CustomerRelationship[] @relation("RelationshipFrom")
  relatedTo            CustomerRelationship[] @relation("RelationshipTo")

  enquiries   Enquiry[]
  salesQuotes SalesQuote[]
  travellers  Traveller[]
  contracts   BookingContract[]
  tickets     Ticket[]

  @@index([organizationId])
  @@index([phone])
  @@index([email])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, deletedAt])
  @@index([organizationId, passportNoHash])
  @@map("customers")
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

enum RelationshipKind {
  FAMILY
  GROUP
  COMPANY
  FRIEND
}

// One row per pair of customers (family member, travel group, company contact).
model CustomerRelationship {
  id                String           @id @default(cuid())
  organizationId    String           @default("org_gktravels")
  organization      Organization     @relation(fields: [organizationId], references: [id])
  customerId        String
  customer          Customer         @relation("RelationshipFrom", fields: [customerId], references: [id], onDelete: Cascade)
  relatedCustomerId String
  related           Customer         @relation("RelationshipTo", fields: [relatedCustomerId], references: [id], onDelete: Cascade)
  kind              RelationshipKind
  note              String?
  createdAt         DateTime         @default(now())

  @@unique([customerId, relatedCustomerId])
  @@index([organizationId])
  @@index([relatedCustomerId])
  @@map("customer_relationships")
}

model Lead {
  organizationId      String       @default("org_gktravels")
  organization        Organization @relation(fields: [organizationId], references: [id])
  id                  String       @id
  name                String
  phone               String
  email               String?
  source              String
  destination         String       @default("")
  travelDate          String?
  pax                 Int          @default(1)
  budget              Float?
  tripType            String       @default("")
  status              String       @default("new")
  priority            String       @default("medium")
  notes               String       @default("")
  followUpDate        String?
  assignedTo          String?
  createdDate         String
  convertedTripId     String?
  convertedCustomerId String?
  convertedAt         String?
  convertedBy         String?
  timeline            Json         @default("[]")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // ── v2 (Phase 2.4) ─────────────────────────────────────────
  phoneNormalized    String?
  assignedToUserId   String?
  assignee           User?     @relation("LeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  lostReason         String?
  convertedEnquiryId String?
  lastContactedAt    DateTime?
  deletedAt          DateTime?
  enquiries          Enquiry[]

  @@index([organizationId])
  @@index([status])
  @@index([assignedTo])
  @@index([assignedToUserId])
  @@index([followUpDate])
  @@index([organizationId, phoneNormalized])
  @@map("leads")
}

model Trip {
  organizationId      String           @default("org_gktravels")
  organization        Organization     @relation(fields: [organizationId], references: [id])
  id                  String           @id
  tripNumber          Int              @unique @default(autoincrement())
  invoiceId           String?
  customer            String
  phone               String           @default("")
  email               String?
  customerId          String?
  destination         String
  type                String           @default("Leisure")
  pax                 Int              @default(1)
  departure           String?
  returnDate          String?
  status              String           @default("draft")
  totalAmount         Float?
  gstRate             Float            @default(5)
  discount            Float            @default(0)
  gstAmount           Float            @default(0)
  totalPayable        Float?
  paidAmount          Float            @default(0)
  balanceDue          Float            @default(0)
  supplierCost        Float            @default(0)
  grossMargin         Float            @default(0)
  marginPct           Float            @default(0)
  visaStatus          String           @default("pending")
  hotelStatus         String           @default("pending")
  flightStatus        String           @default("pending")
  checkInStatus       String           @default("not_due")
  notes               String           @default("")
  assignedTo          String?
  createdDate         String
  createdBy           String?
  sourceLeadId        String?
  convertedFromLeadId String?
  convertedAt         String?
  convertedBy         String?
  timeline            Json             @default("[]")
  itinerary           Json             @default("[]")
  documents           Json             @default("[]")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  gstMode             GstMode          @default(EXCLUDED)
  taxableAmount       Float            @default(0)
  passengerIds        Json             @default("[]")
  payments            Payment[]
  tasks               Task[]
  services            TripService[]
  travellers          TripTraveller[]
  contract            BookingContract?

  // Phase 3: operational stage (legacy "status" is kept in step for the classic screens).
  stage               TripStage          @default(PLANNING)
  hotelBookings       HotelBooking[]
  vehicleAssignments  VehicleAssignment[]
  activityBookings    ActivityBooking[]
  tickets             Ticket[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, stage])
  @@index([departure])
  @@index([customerId])
  @@index([invoiceId])
  @@map("trips")
}

model Booking {
  organizationId    String       @default("org_gktravels")
  organization      Organization @relation(fields: [organizationId], references: [id])
  id                String       @id
  invoiceId         String?
  type              String
  status            String       @default("pending")
  customerName      String
  customerId        String?
  refId             String?
  sellingPrice      Float?
  supplierCost      Float        @default(0)
  advance           Float        @default(0)
  supplierPaid      Float        @default(0)
  gstRate           Float        @default(0)
  gstAmount         Float        @default(0)
  totalPayable      Float?
  balanceDue        Float        @default(0)
  supplierPending   Float        @default(0)
  grossMargin       Float        @default(0)
  marginPct         Float        @default(0)
  detail            Json         @default("{}")
  notes             String       @default("")
  createdDate       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  gstMode           GstMode      @default(EXCLUDED)
  taxableAmount     Float        @default(0)
  convenienceFee    Float        @default(0)
  financialStatus   String       @default("unpaid")
  gstOnFee          Float        @default(0)
  taxableFee        Float        @default(0)
  serviceMarginMode Boolean      @default(false)
  passengerIds      Json         @default("[]")

  @@index([organizationId])
  @@index([refId])
  @@index([status])
  @@index([type])
  @@index([customerId])
  @@index([invoiceId])
  @@map("bookings")
}

model Payment {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id
  type           String
  tripId         String?
  bookingId      String?
  customer       String?
  customerId     String?
  amount         Float
  method         String
  date           String
  paidDate       String?
  status         String
  reference      String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  trip           Trip?        @relation(fields: [tripId], references: [id])

  @@index([organizationId])
  @@index([tripId])
  @@index([customerId])
  @@index([bookingId])
  @@index([type, status])
  @@index([date])
  @@map("payments")
}

model Receivable {
  organizationId String            @default("org_gktravels")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  id             String            @id
  customerId     String?
  customerName   String
  bookingId      String?
  tripId         String?
  invoiceId      String?
  invoiceAmount  Float
  description    String            @default("")
  dueDate        String?
  totalReceived  Float             @default(0)
  balanceDue     Float             @default(0)
  notes          String            @default("")
  createdDate    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  entries        ReceivableEntry[]

  @@index([organizationId])
  @@index([customerId])
  @@index([bookingId])
  @@index([tripId])
  @@index([invoiceId])
  @@map("receivables")
}

model ReceivableEntry {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id
  receivableId   String
  amount         Float
  paymentDate    String
  paymentMode    String
  reference      String?
  notes          String?
  createdAt      DateTime     @default(now())
  receivable     Receivable   @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([receivableId])
  @@map("receivable_entries")
}

model FinancialTransaction {
  organizationId  String                   @default("org_gktravels")
  organization    Organization             @relation(fields: [organizationId], references: [id])
  id              String                   @id @default(cuid())
  type            FinancialTransactionType
  sourceType      String
  sourceId        String
  customerId      String?
  vendorId        String?
  tripId          String?
  bookingId       String?
  amount          Float
  gstAmount       Float                    @default(0)
  taxableAmount   Float                    @default(0)
  description     String                   @default("")
  transactionDate String
  paymentMode     String?
  reference       String?
  createdBy       String?
  createdAt       DateTime                 @default(now())

  @@index([organizationId])
  @@index([customerId])
  @@index([vendorId])
  @@index([tripId])
  @@index([bookingId])
  @@index([sourceType, sourceId])
  @@map("financial_transactions")
}

model Task {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id
  title          String
  description    String?
  priority       String       @default("medium")
  status         String       @default("pending")
  tripId         String?
  bookingId      String?
  customerId     String?
  dueDate        String?
  assignedTo     String?
  completedDate  String?
  createdDate    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  trip           Trip?        @relation(fields: [tripId], references: [id])

  @@index([organizationId])
  @@index([tripId])
  @@index([status, dueDate])
  @@index([assignedTo])
  @@map("tasks")
}

model ActivityLog {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id @default(cuid())
  action         String
  description    String
  entityType     String
  entityId       String
  userId         String?
  timestamp      String
  date           String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())
  metadata       Json?
  title          String?
  source         String       @default("HUMAN")
  requestId      String?

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([date])
  @@index([action])
  @@map("activity_logs")
}

model Communication {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id @default(cuid())
  type           String
  recipient      String
  subject        String?
  entityType     String
  entityId       String
  userId         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([type])
  @@map("communications")
}

model Reminder {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id @default(cuid())
  tripId         String?
  type           String
  priority       String
  message        String
  dueDate        String
  sent           Boolean      @default(false)
  sentAt         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("reminders")
}

model Vendor {
  organizationId  String           @default("org_gktravels")
  organization    Organization     @relation(fields: [organizationId], references: [id])
  id              String           @id
  name            String
  companyName     String?
  type            String
  contactPerson   String?
  phone           String
  whatsapp        String?
  email           String?
  destinations    Json             @default("[]")
  paymentTerms    String?
  bankDetails     Json             @default("{}")
  gstNumber       String?
  notes           String?
  isActive        Boolean          @default(true)
  createdDate     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  payments        VendorPayment[]
  tripServices    TripService[]
  salesQuoteItems SalesQuoteItem[]

  // v2 (Phase 3.1). "type" is kept in step for the classic Suppliers screen.
  kind            VendorKind       @default(OTHER)
  city            String?
  state           String?
  address         String?
  pan             String?
  phoneNormalized String?
  creditDays      Int?
  hotels          Hotel[]
  vehicles        Vehicle[]
  drivers         Driver[]
  activities      Activity[]
  hotelBookings      HotelBooking[]
  vehicleAssignments VehicleAssignment[]
  activityBookings   ActivityBooking[]
  tickets            Ticket[]

  @@index([organizationId])
  @@index([type])
  @@index([organizationId, kind])
  @@index([organizationId, phoneNormalized])
  @@map("vendors")
}

model VendorPayment {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id
  vendorId       String
  vendorName     String
  tripId         String?
  tripName       String?
  description    String?
  totalCost      Float        @default(0)
  advancePaid    Float        @default(0)
  outstanding    Float        @default(0)
  isPaid         Boolean      @default(false)
  paidDate       String?
  dueDate        String?
  notes          String?
  createdDate    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vendorId])
  @@index([tripId])
  @@map("vendor_payments")
}

model Quotation {
  organizationId  String          @default("org_gktravels")
  organization    Organization    @relation(fields: [organizationId], references: [id])
  id              String          @id
  quotationNumber String
  customerId      String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  destination     String
  startDate       String?
  endDate         String?
  pax             Int             @default(1)
  status          String          @default("draft")
  notes           String?
  termsAndConds   String?
  validUntil      String?
  totalCost       Float           @default(0)
  totalSelling    Float           @default(0)
  grossProfit     Float           @default(0)
  marginPct       Float           @default(0)
  convertedTripId String?
  convertedAt     String?
  createdDate     String
  sentAt          String?
  acceptedAt      String?
  rejectedAt      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  gstMode         GstMode         @default(EXCLUDED)
  taxableAmount   Float           @default(0)
  exclusions      String?
  gstAmount       Float           @default(0)
  gstRate         Float           @default(0)
  inclusions      String?
  paymentPolicy   String?
  approvalComment String?
  approvalStatus  String          @default("DRAFT")
  approvedAt      String?
  approvedBy      String?
  submittedAt     String?
  submittedBy     String?
  items           QuotationItem[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([status])
  @@index([approvalStatus])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id @default(cuid())
  quotationId    String
  category       String
  description    String
  quantity       Int          @default(1)
  costPrice      Float        @default(0)
  sellingPrice   Float        @default(0)
  vendorId       String?
  vendorName     String?
