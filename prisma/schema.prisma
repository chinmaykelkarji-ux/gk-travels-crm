generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Customer {
  id             String   @id
  customerNumber Int      @unique @default(autoincrement())
  name           String
  phone          String
  altPhone       String?
  email          String?
  address        String?
  city           String?
  preferences    Json     @default("{}")
  notes          String?
  tripIds        Json     @default("[]")
  documents      Json     @default("[]")
  createdDate    String
  sourceLeadId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  billingAddress String?
  companyName    String?
  gstNumber      String?
  gstRegistered  Boolean  @default(false)
  state          String?
  enquiries      Enquiry[]
  salesQuotes    SalesQuote[]

  @@map("customers")
}

model Lead {
  id                  String   @id
  name                String
  phone               String
  email               String?
  source              String
  destination         String   @default("")
  travelDate          String?
  pax                 Int      @default(1)
  budget              Float?
  tripType            String   @default("")
  status              String   @default("new")
  priority            String   @default("medium")
  notes               String   @default("")
  followUpDate        String?
  assignedTo          String?
  createdDate         String
  convertedTripId     String?
  convertedCustomerId String?
  convertedAt         String?
  convertedBy         String?
  timeline            Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("leads")
}

model Trip {
  id                  String    @id
  tripNumber          Int       @unique @default(autoincrement())
  invoiceId           String?
  customer            String
  phone               String    @default("")
  email               String?
  customerId          String?
  destination         String
  type                String    @default("Leisure")
  pax                 Int       @default(1)
  departure           String?
  returnDate          String?
  status              String    @default("draft")
  totalAmount         Float?
  gstRate             Float     @default(5)
  discount            Float     @default(0)
  gstAmount           Float     @default(0)
  totalPayable        Float?
  paidAmount          Float     @default(0)
  balanceDue          Float     @default(0)
  supplierCost        Float     @default(0)
  grossMargin         Float     @default(0)
  marginPct           Float     @default(0)
  visaStatus          String    @default("pending")
  hotelStatus         String    @default("pending")
  flightStatus        String    @default("pending")
  checkInStatus       String    @default("not_due")
  notes               String    @default("")
  assignedTo          String?
  createdDate         String
  createdBy           String?
  sourceLeadId        String?
  convertedFromLeadId String?
  convertedAt         String?
  convertedBy         String?
  timeline            Json      @default("[]")
  itinerary           Json      @default("[]")
  documents           Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  gstMode             GstMode   @default(EXCLUDED)
  taxableAmount       Float     @default(0)
  passengerIds        Json      @default("[]")
  payments            Payment[]
  tasks               Task[]
  services            TripService[]

  @@map("trips")
}

model Booking {
  id                String   @id
  invoiceId         String?
  type              String
  status            String   @default("pending")
  customerName      String
  customerId        String?
  refId             String?
  sellingPrice      Float?
  supplierCost      Float    @default(0)
  advance           Float    @default(0)
  supplierPaid      Float    @default(0)
  gstRate           Float    @default(0)
  gstAmount         Float    @default(0)
  totalPayable      Float?
  balanceDue        Float    @default(0)
  supplierPending   Float    @default(0)
  grossMargin       Float    @default(0)
  marginPct         Float    @default(0)
  detail            Json     @default("{}")
  notes             String   @default("")
  createdDate       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  gstMode           GstMode  @default(EXCLUDED)
  taxableAmount     Float    @default(0)
  convenienceFee    Float    @default(0)
  financialStatus   String   @default("unpaid")
  gstOnFee          Float    @default(0)
  taxableFee        Float    @default(0)
  serviceMarginMode Boolean  @default(false)
  passengerIds      Json     @default("[]")

  @@map("bookings")
}

model Payment {
  id         String   @id
  type       String
  tripId     String?
  bookingId  String?
  customer   String?
  customerId String?
  amount     Float
  method     String
  date       String
  paidDate   String?
  status     String
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  trip       Trip?    @relation(fields: [tripId], references: [id])

  @@map("payments")
}

model Receivable {
  id            String            @id
  customerId    String?
  customerName  String
  bookingId     String?
  tripId        String?
  invoiceId     String?
  invoiceAmount Float
  description   String            @default("")
  dueDate       String?
  totalReceived Float             @default(0)
  balanceDue    Float             @default(0)
  notes         String            @default("")
  createdDate   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  entries       ReceivableEntry[]

  @@index([customerId])
  @@index([bookingId])
  @@index([tripId])
  @@index([invoiceId])
  @@map("receivables")
}

model ReceivableEntry {
  id           String     @id
  receivableId String
  amount       Float
  paymentDate  String
  paymentMode  String
  reference    String?
  notes        String?
  createdAt    DateTime   @default(now())
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([receivableId])
  @@map("receivable_entries")
}

model FinancialTransaction {
  id              String                   @id @default(cuid())
  type            FinancialTransactionType
  sourceType      String
  sourceId        String
  customerId      String?
  vendorId        String?
  tripId          String?
  bookingId       String?
  amount          Float
  gstAmount       Float                    @default(0)
  taxableAmount   Float                    @default(0)
  description     String                   @default("")
  transactionDate String
  paymentMode     String?
  reference       String?
  createdBy       String?
  createdAt       DateTime                 @default(now())

  @@index([customerId])
  @@index([vendorId])
  @@index([tripId])
  @@index([bookingId])
  @@index([sourceType, sourceId])
  @@map("financial_transactions")
}

model Task {
  id            String   @id
  title         String
  description   String?
  priority      String   @default("medium")
  status        String   @default("pending")
  tripId        String?
  bookingId     String?
  customerId    String?
  dueDate       String?
  assignedTo    String?
  completedDate String?
  createdDate   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trip          Trip?    @relation(fields: [tripId], references: [id])

  @@map("tasks")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  description String
  entityType  String
  entityId    String
  userId      String?
  timestamp   String
  date        String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
  metadata    Json?
  title       String?

  @@index([entityType, entityId])
  @@index([date])
  @@index([action])
  @@map("activity_logs")
}

model Communication {
  id         String   @id @default(cuid())
  type       String
  recipient  String
  subject    String?
  entityType String
  entityId   String
  userId     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([type])
  @@map("communications")
}

model Reminder {
  id        String   @id @default(cuid())
  tripId    String?
  type      String
  priority  String
  message   String
  dueDate   String
  sent      Boolean  @default(false)
  sentAt    String?
  createdAt DateTime @default(now())

  @@map("reminders")
}

model Vendor {
  id            String          @id
  name          String
  companyName   String?
  type          String
  contactPerson String?
  phone         String
  whatsapp      String?
  email         String?
  destinations  Json            @default("[]")
  paymentTerms  String?
  bankDetails   Json            @default("{}")
  gstNumber     String?
  notes         String?
  isActive      Boolean         @default(true)
  createdDate   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  payments      VendorPayment[]
  tripServices  TripService[]
  salesQuoteItems SalesQuoteItem[]

  @@index([type])
  @@map("vendors")
}

model VendorPayment {
  id          String   @id
  vendorId    String
  vendorName  String
  tripId      String?
  tripName    String?
  description String?
  totalCost   Float    @default(0)
  advancePaid Float    @default(0)
  outstanding Float    @default(0)
  isPaid      Boolean  @default(false)
  paidDate    String?
  dueDate     String?
  notes       String?
  createdDate String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([tripId])
  @@map("vendor_payments")
}

model Quotation {
  id              String          @id
  quotationNumber String          @unique
  customerId      String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  destination     String
  startDate       String?
  endDate         String?
  pax             Int             @default(1)
  status          String          @default("draft")
  notes           String?
  termsAndConds   String?
  validUntil      String?
  totalCost       Float           @default(0)
  totalSelling    Float           @default(0)
  grossProfit     Float           @default(0)
  marginPct       Float           @default(0)
  convertedTripId String?
  convertedAt     String?
  createdDate     String
  sentAt          String?
  acceptedAt      String?
  rejectedAt      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  gstMode         GstMode         @default(EXCLUDED)
  taxableAmount   Float           @default(0)
  exclusions      String?
  gstAmount       Float           @default(0)
  gstRate         Float           @default(0)
  inclusions      String?
  paymentPolicy   String?
  approvalComment String?
  approvalStatus  String          @default("DRAFT")
  approvedAt      String?
  approvedBy      String?
  submittedAt     String?
  submittedBy     String?
  items           QuotationItem[]

  @@index([status])
  @@index([approvalStatus])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  category     String
  description  String
  quantity     Int       @default(1)
  costPrice    Float     @default(0)
  sellingPrice Float     @default(0)
  vendorId     String?
  vendorName   String?
  totalCost    Float     @default(0)
  totalSelling Float     @default(0)
  grossProfit  Float     @default(0)
  marginPct    Float     @default(0)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Itinerary {
  id               String         @id
  tripId           String?
  quotationId      String?
  title            String
  destination      String
  customerName     String
  customerPhone    String?
  customerEmail    String?
  startDate        String?
  endDate          String?
  pax              Int            @default(1)
  status           String         @default("draft")
  notes            String?
  emergencyContact String?
  template         String?
  createdDate      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  passengerIds     Json           @default("[]")
  days             ItineraryDay[]

  @@index([tripId])
  @@index([quotationId])
  @@index([status])
  @@map("itineraries")
}

model ItineraryDay {
  id           String    @id @default(cuid())
  itineraryId  String
  dayNumber    Int
  date         String?
  title        String
  morning      String?
  afternoon    String?
  evening      String?
  hotelName    String?
  hotelAddress String?
  meals        Json      @default("[]")
  transfers    String?
  activities   Json      @default("[]")
  notes        String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  itinerary    Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@map("itinerary_days")
}

model Voucher {
  id               String   @id
  voucherNumber    String   @unique
  tripId           String?
  customerId       String?
  vendorId         String?
  type             String
  status           String   @default("draft")
  issueDate        String?
  customerName     String
  customerPhone    String?
  guestNames       String?
  destination      String?
  hotelName        String?
  hotelAddress     String?
  hotelPhone       String?
  checkIn          String?
  checkOut         String?
  roomType         String?
  mealPlan         String?
  confirmationNo   String?
  nights           Int?
  pickupPoint      String?
  dropPoint        String?
  pickupDate       String?
  pickupTime       String?
  vehicleType      String?
  driverName       String?
  driverPhone      String?
  flightInfo       String?
  activityName     String?
  activityDate     String?
  activityTime     String?
  activityVenue    String?
  activityNotes    String?
  operatorName     String?
  busType          String?
  busNumber        String?
  fromLocation     String?
  toLocation       String?
  boardingPoint    String?
  droppingPoint    String?
  seatNumbers      String?
  duration         String?
  reportingTime    String?
  airline          String?
  flightNumber     String?
  pnr              String?
  departure        String?
  arrival          String?
  departureDate    String?
  arrivalDate      String?
  flightClass      String?
  visaType         String?
  country          String?
  entryType        String?
  validity         String?
  visaFee          Float?
  vendorName       String?
  vendorPhone      String?
  vendorEmail      String?
  pax              Int      @default(1)
  notes            String?
  emergencyContact String?
  internalNotes    String?
  createdDate      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  gstAmount        Float    @default(0)
  gstMode          GstMode  @default(EXCLUDED)
  gstRate          Float    @default(0)
  taxableAmount    Float    @default(0)
  totalPayable     Float?
  passengerIds     Json     @default("[]")

  @@index([tripId])
  @@index([vendorId])
  @@index([status])
  @@index([type])
  @@map("vouchers")
}

model Passenger {
  id                    String   @id
  customerId            String?
  firstName             String
  lastName              String
  displayName           String?
  dateOfBirth           String?
  nationality           String?
  gender                String?
  passportNumber        String?
  passportIssueDate     String?
  passportExpiry        String?
  placeOfIssue          String?
  visaStatus            String?
  visaExpiry            String?
  visaCountry           String?
  visaType              String?
  frequentFlyerNumber   String?
  mealPreference        String?
  seatPreference        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelation     String?
  notes                 String?
  createdDate           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([customerId])
  @@index([passportNumber])
  @@map("passengers")
}

// ============================================================
// GST INVOICING — Company Master, Numbering, Invoices, CN/DN
// ============================================================

// Singleton row (id = "default") holding the agency's GST/legal/bank
// details. Printed on Invoices, Credit/Debit Notes, Quotations, Vouchers.
model CompanySettings {
  id                  String   @id @default("default")
  companyName         String   @default("GK Travels")
  legalName           String?
  gstin               String?
  pan                 String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  stateCode           String?
  pincode             String?
  phone               String?
  email               String?
  website             String?
  logoUrl             String?
  bankName            String?
  bankAccountName     String?
  bankAccountNumber   String?
  bankIfsc            String?
  bankBranch          String?
  invoicePrefix       String   @default("GK")
  invoiceTerms        String?
  authorizedSignatory String?
  signatureUrl        String?
  // GST returns filed up to this date (inclusive) — invoices/CN/DN dated on
  // or before this date are frozen (no edit/cancel/delete).
  gstFrozenUntil      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("company_settings")
}

// Per (docType, financialYear) running counter for sequential, gap-free
// document numbering (GK/2026-27/01, CN/2026-27/0001, DN/2026-27/0001).
model NumberingSequence {
  id            String   @id
  docType       String
  financialYear String
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([docType, financialYear])
  @@map("numbering_sequences")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum DocStatus {
  ISSUED
  CANCELLED
}

enum GstType {
  INTRA
  INTER
}

model Invoice {
  id                String          @id
  invoiceNumber     String          @unique
  financialYear     String
  sequenceNumber    Int
  status            InvoiceStatus   @default(ISSUED)
  invoiceDate       String
  dueDate           String?

  // Customer / billing snapshot
  customerId        String?
  customerName      String
  customerAddress   String?
  customerGstin     String?
  customerStateCode String?
  placeOfSupply     String?

  // Company snapshot at time of issue (immutable even if Company Master changes later)
  companyName       String
  companyAddress    String?
  companyGstin      String?
  companyStateCode  String?

  // GST breakdown
  gstType           GstType         @default(INTRA)
  taxableAmount     Float           @default(0)
  cgstAmount        Float           @default(0)
  sgstAmount        Float           @default(0)
  igstAmount        Float           @default(0)
  totalGstAmount    Float           @default(0)
  totalAmount       Float           @default(0)

  notes             String?
  termsAndConds     String?

  // Source bookings/trips this invoice was generated from (locked once invoiced)
  bookingIds        Json            @default("[]")
  tripIds           Json            @default("[]")
  receivableId      String?

  createdDate       String
  createdBy         String?
  cancelledAt       String?
  cancelledBy       String?
  cancelReason      String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items             InvoiceLineItem[]
  creditNotes       CreditNote[]
  debitNotes        DebitNote[]

  @@index([customerId])
  @@index([financialYear])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  hsnSac      String?
  serviceType String?
  bookingId   String?
  quantity    Float   @default(1)
  rate        Float   @default(0)
  amount      Float   @default(0)
  gstRate     Float   @default(0)
  gstAmount   Float   @default(0)
  totalAmount Float   @default(0)
  sortOrder   Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model CreditNote {
  id               String              @id
  creditNoteNumber String              @unique
  financialYear    String
  sequenceNumber   Int
  status           DocStatus           @default(ISSUED)
  date             String
  invoiceId        String
  invoice          Invoice             @relation(fields: [invoiceId], references: [id])
  customerId       String?
  customerName     String
  reason           String
  reasonDetails    String?
  taxableAmount    Float               @default(0)
  cgstAmount       Float               @default(0)
  sgstAmount       Float               @default(0)
  igstAmount       Float               @default(0)
  totalGstAmount   Float               @default(0)
  totalAmount      Float               @default(0)
  notes            String?
  createdDate      String
  createdBy        String?
  cancelledAt      String?
  cancelledBy      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  items            CreditNoteLineItem[]

  @@index([invoiceId])
  @@index([financialYear])
  @@index([customerId])
  @@map("credit_notes")
}

model CreditNoteLineItem {
  id           String     @id @default(cuid())
  creditNoteId String
  description  String
  hsnSac       String?
  quantity     Float      @default(1)
  rate         Float      @default(0)
  amount       Float      @default(0)
  gstRate      Float      @default(0)
  gstAmount    Float      @default(0)
  totalAmount  Float      @default(0)
  sortOrder    Int        @default(0)
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
  @@map("credit_note_line_items")
}

model DebitNote {
  id              String             @id
  debitNoteNumber String             @unique
  financialYear   String
  sequenceNumber  Int
  status          DocStatus          @default(ISSUED)
  date            String
  invoiceId       String
  invoice         Invoice            @relation(fields: [invoiceId], references: [id])
  customerId      String?
  customerName    String
  reason          String
  reasonDetails   String?
  taxableAmount   Float              @default(0)
  cgstAmount      Float              @default(0)
  sgstAmount      Float              @default(0)
  igstAmount      Float              @default(0)
  totalGstAmount  Float              @default(0)
  totalAmount     Float              @default(0)
  notes           String?
  createdDate     String
  createdBy       String?
  cancelledAt     String?
  cancelledBy     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           DebitNoteLineItem[]

  @@index([invoiceId])
  @@index([financialYear])
  @@index([customerId])
  @@map("debit_notes")
}

model DebitNoteLineItem {
  id          String    @id @default(cuid())
  debitNoteId String
  description String
  hsnSac      String?
  quantity    Float     @default(1)
  rate        Float     @default(0)
  amount      Float     @default(0)
  gstRate     Float     @default(0)
  gstAmount   Float     @default(0)
  totalAmount Float     @default(0)
  sortOrder   Int       @default(0)
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@index([debitNoteId])
  @@map("debit_note_line_items")
}

enum FinancialTransactionType {
  RECEIVABLE
  PAYMENT_RECEIVED
  PAYABLE
  PAYMENT_SENT
  GST_OUTPUT
  GST_INPUT
  REFUND
  ADJUSTMENT
}

enum Role {
  ADMIN
  BOOKING
  OPERATIONS
  ACCOUNTS
}

enum GstMode {
  INCLUDED
  EXCLUDED
}

// ============================================================
// OPERATIONS — Trip Service Spine
// ============================================================

// Unified record for every bookable service inside a trip (flight, hotel,
// vehicle, activity, transfer). Dashboards, timelines, and automations
// query this single table rather than per-type tables.
model TripService {
  id          String        @id @default(cuid())
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type        ServiceType
  status      ServiceStatus @default(DRAFT)
  serviceDate DateTime
  startTime   String?
  endTime     String?
  supplierId  String?
  supplier    Vendor?       @relation(fields: [supplierId], references: [id])
  costPrice   Decimal       @default(0) @db.Decimal(10, 2)
  sellPrice   Decimal       @default(0) @db.Decimal(10, 2)
  details     Json          @default("{}")
  notes       String?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tripId])
  @@index([supplierId])
  @@index([serviceDate])
  @@index([status])
  @@map("trip_services")
}

enum ServiceType {
  FLIGHT
  BUS
  HOTEL
  VEHICLE
  ACTIVITY
  TRANSFER
  VISA
  INSURANCE
  OTHER
}

enum ServiceStatus {
  DRAFT
  REQUESTED
  PENDING
  CONFIRMED
  COMPLETED
  VOUCHER_RECEIVED
  CANCELLED
}

// ============================================================
// OPERATIONS — Outbox / Event Rail
// ============================================================

// Every automation-relevant state change writes a row here. A background
// worker dispatches PENDING rows exactly once (idempotencyKey-deduped),
// giving automations a durable, restart-safe audit trail.
model OutboxEvent {
  id             String       @id @default(cuid())
  eventType      String
  payload        Json
  status         OutboxStatus @default(PENDING)
  idempotencyKey String       @unique
  scheduledFor   DateTime     @default(now())
  processedAt    DateTime?
  attempts       Int          @default(0)
  lastError      String?
  createdAt      DateTime     @default(now())

  @@index([status, scheduledFor])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// Record of every WhatsApp/email message sent to a customer or supplier.
model MessageLog {
  id           String   @id @default(cuid())
  tripId       String?
  customerId   String?
  channel      String
  templateName String?
  recipient    String
  content      String
  status       String
  sentAt       DateTime @default(now())
  error        String?

  @@index([tripId])
  @@index([customerId])
  @@map("message_logs")
}

// ============================================================
// SALES PIPELINE — Enquiry -> SalesQuote -> Confirmed Trip
//
// Named "SalesQuote"/"SalesQuoteItem" (not "Quotation") to avoid
// colliding with the existing GST Quotation/QuotationItem models,
// which remain a separate, untouched feature.
// ============================================================

model Enquiry {
  id            String        @id @default(cuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  source        EnquirySource @default(DIRECT)
  destination   String
  departureDate DateTime?
  returnDate    DateTime?
  pax           Int           @default(1)
  requirements  String?
  budget        Decimal?      @db.Decimal(10, 2)
  status        EnquiryStatus @default(NEW)
  assignedTo    String?
  notes         String?
  salesQuotes   SalesQuote[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("enquiries")
}

model SalesQuote {
  id              String           @id @default(cuid())
  enquiryId       String
  enquiry         Enquiry          @relation(fields: [enquiryId], references: [id])
  quoteNumber     String           @unique
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  status          SalesQuoteStatus @default(DRAFT)
  validUntil      DateTime
  lineItems       SalesQuoteItem[]
  subtotal        Decimal          @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal          @default(0) @db.Decimal(10, 2)
  notes           String?
  termsConditions String?
  sentAt          DateTime?
  viewedAt        DateTime?
  convertedAt     DateTime?
  convertedTripId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([enquiryId])
  @@index([customerId])
  @@index([status])
  @@map("sales_quotes")
}

model SalesQuoteItem {
  id           String      @id @default(cuid())
  salesQuoteId String
  salesQuote   SalesQuote  @relation(fields: [salesQuoteId], references: [id], onDelete: Cascade)
  serviceType  ServiceType
  description  String
  supplierId   String?
  supplier     Vendor?     @relation(fields: [supplierId], references: [id])
  costPrice    Decimal     @db.Decimal(10, 2)
  markup       Decimal     @default(0) @db.Decimal(10, 2)
  sellPrice    Decimal     @db.Decimal(10, 2)
  quantity     Int         @default(1)
  unit         String      @default("per person")
  details      Json        @default("{}")
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([salesQuoteId])
  @@index([supplierId])
  @@map("sales_quote_items")
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum EnquirySource {
  DIRECT
  WHATSAPP
  PHONE
  EMAIL
  REFERRAL
  WEBSITE
}

enum SalesQuoteStatus {
  DRAFT
  SENT
  VIEWED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
}
