// ============================================================
// GST INVOICING — Company Master, Numbering, Invoices, CN/DN
// ============================================================

// Singleton row (id = "default") holding the agency's GST/legal/bank
// details. Printed on Invoices, Credit/Debit Notes, Quotations, Vouchers.
model CompanySettings {
  organizationId      String       @unique @default("org_gktravels")
  organization        Organization @relation(fields: [organizationId], references: [id])
  id                  String       @id @default(cuid())
  companyName         String       @default("GK Travels")
  legalName           String?
  gstin               String?
  pan                 String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  stateCode           String?
  pincode             String?
  phone               String?
  email               String?
  website             String?
  logoUrl             String?
  bankName            String?
  bankAccountName     String?
  bankAccountNumber   String?
  bankIfsc            String?
  bankBranch          String?
  invoicePrefix       String       @default("GK")
  invoiceTerms        String?
  authorizedSignatory String?
  signatureUrl        String?
  // GST returns filed up to this date (inclusive) — invoices/CN/DN dated on
  // or before this date are frozen (no edit/cancel/delete).
  gstFrozenUntil      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId])
  @@map("company_settings")
}

// Per (docType, financialYear) running counter for sequential, gap-free
// document numbering (GK/2026-27/01, CN/2026-27/0001, DN/2026-27/0001).
model NumberingSequence {
  organizationId String       @default("org_gktravels")
  organization   Organization @relation(fields: [organizationId], references: [id])
  id             String       @id
  docType        String
  financialYear  String
  lastNumber     Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, docType, financialYear])
  @@index([organizationId])
  @@map("numbering_sequences")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum DocStatus {
  ISSUED
  CANCELLED
}

enum GstType {
  INTRA
  INTER
}

model Invoice {
  organizationId String        @default("org_gktravels")
  organization   Organization  @relation(fields: [organizationId], references: [id])
  id             String        @id
  invoiceNumber  String
  financialYear  String
  sequenceNumber Int
  status         InvoiceStatus @default(ISSUED)
  invoiceDate    String
  dueDate        String?

  // Customer / billing snapshot
  customerId        String?
  customerName      String
  customerAddress   String?
  customerGstin     String?
  customerStateCode String?
  placeOfSupply     String?

  // Company snapshot at time of issue (immutable even if Company Master changes later)
  companyName      String
  companyAddress   String?
  companyGstin     String?
  companyStateCode String?

  // GST breakdown
  gstType        GstType @default(INTRA)
  taxableAmount  Float   @default(0)
  cgstAmount     Float   @default(0)
  sgstAmount     Float   @default(0)
  igstAmount     Float   @default(0)
  totalGstAmount Float   @default(0)
  totalAmount    Float   @default(0)

  notes         String?
  termsAndConds String?

  /// TCS collected on an overseas package, when the tax rule is switched on.
  /// (The older money columns on this table are Float from the classic
  /// screens; new ones are Decimal, as money should be.)
  tcsRate    Decimal? @db.Decimal(5, 2)
  tcsAmount  Decimal  @default(0) @db.Decimal(12, 2)
  isOverseas Boolean  @default(false)

  // Source bookings/trips this invoice was generated from (locked once invoiced)
  bookingIds   Json    @default("[]")
  tripIds      Json    @default("[]")
  receivableId String?

  createdDate  String
  createdBy    String?
  cancelledAt  String?
  cancelledBy  String?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       InvoiceLineItem[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([financialYear])
  @@index([status])
  @@map("invoices")
}

