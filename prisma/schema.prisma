generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Customer {
  id             String   @id
  // Sequential, human-facing display number ("Customer #N"). DB-generated
  // only — never accepted from the client. Backed by its own Postgres
  // sequence so values are atomic, gap-free under concurrency, and never
  // reused even after a delete.
  customerNumber Int      @unique @default(autoincrement())
  name         String
  phone        String
  altPhone     String?
  email        String?
  address      String?
  city         String?
  preferences  Json     @default("{}")
  notes        String?
  tripIds      Json     @default("[]")
  documents    Json     @default("[]")
  createdDate  String
  sourceLeadId String?

  // GST / business details (optional — retail customers don't need these)
  gstNumber      String?
  companyName    String?
  billingAddress String?
  state          String?
  gstRegistered  Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("customers")
}

model Lead {
  id                  String   @id
  name                String
  phone               String
  email               String?
  source              String
  destination         String   @default("")
  travelDate          String?
  pax                 Int      @default(1)
  budget              Float?
  tripType            String   @default("")
  status              String   @default("new")
  priority            String   @default("medium")
  notes               String   @default("")
  followUpDate        String?
  assignedTo          String?
  createdDate         String
  convertedTripId     String?
  convertedCustomerId String?
  convertedAt         String?
  convertedBy         String?
  timeline            Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("leads")
}

model Trip {
  id                  String    @id
  // Sequential, human-facing display number ("Trip #N"). DB-generated only —
  // never accepted from the client. Backed by its own Postgres sequence so
  // values are atomic, gap-free under concurrency, and never reused even
  // after a delete.
  tripNumber          Int       @unique @default(autoincrement())
  customer            String
  phone               String    @default("")
  email               String?
  customerId          String?
  destination         String
  type                String    @default("Leisure")
  pax                 Int       @default(1)
  departure           String?
  returnDate          String?
  status              String    @default("draft")
  totalAmount         Float?
  gstRate             Float     @default(5)
  gstMode             GstMode   @default(EXCLUDED)
  taxableAmount       Float     @default(0)
  discount            Float     @default(0)
  gstAmount           Float     @default(0)
  totalPayable        Float?
  paidAmount          Float     @default(0)
  balanceDue          Float     @default(0)
  supplierCost        Float     @default(0)
  grossMargin         Float     @default(0)
  marginPct           Float     @default(0)
  visaStatus          String    @default("pending")
  hotelStatus         String    @default("pending")
  flightStatus        String    @default("pending")
  checkInStatus       String    @default("not_due")
  notes               String    @default("")
  assignedTo          String?
  createdDate         String
  createdBy           String?
  sourceLeadId        String?
  convertedFromLeadId String?
  convertedAt         String?
  convertedBy         String?
  timeline            Json      @default("[]")
  itinerary           Json      @default("[]")
  documents           Json      @default("[]")
  passengerIds        Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  payments            Payment[]
  tasks               Task[]

  @@map("trips")
}

model Booking {
id              String   @id
type            String
status          String   @default("pending")

financialStatus String   @default("unpaid")

customerName    String
customerId      String?
refId           String?

sellingPrice    Float?
supplierCost    Float    @default(0)

advance         Float    @default(0)
supplierPaid    Float    @default(0)

gstRate         Float    @default(0)
gstMode         GstMode  @default(EXCLUDED)
gstAmount       Float    @default(0)
taxableAmount   Float    @default(0)

// Service Margin Mode (flight/train/bus/hotel/cab/activity & other vendor-
// arranged services): Convenience Fee is a manually entered service charge;
// GST applies ONLY on it — never on the full supplier/vendor amount.
// Invoice Total = Supplier Cost + Convenience Fee (+ GST on fee when
// EXCLUDED). taxableFee/gstOnFee are the GST breakdown of the convenience fee.
serviceMarginMode Boolean @default(false)
convenienceFee    Float   @default(0)
taxableFee        Float   @default(0)
gstOnFee          Float   @default(0)

totalPayable    Float?
balanceDue      Float    @default(0)

supplierPending Float    @default(0)

grossMargin     Float    @default(0)
marginPct       Float    @default(0)

detail          Json     @default("{}")
passengerIds    Json     @default("[]")
notes           String   @default("")

createdDate     String

createdAt       DateTime @default(now())
updatedAt       DateTime @updatedAt

  @@map("bookings")
}

model Payment {
  id         String   @id
  type       String
  tripId     String?
  bookingId  String?
  customer   String?
  customerId String?
  amount     Float
  method     String
  date       String
  paidDate   String?
  status     String
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  trip       Trip?    @relation(fields: [tripId], references: [id])

  @@map("payments")
}

model Receivable {
  id            String   @id
  customerId    String?
  customerName  String
  bookingId     String?
  tripId        String?
  invoiceAmount Float
  description   String   @default("")
  dueDate       String?

  // Cached aggregates — pure numeric derivations of entries, recalculated on
  // every entry change (mirrors Booking.financialStatus pattern). Status
  // ('pending'/'partial'/'paid'/'overdue') is intentionally NOT stored here:
  // 'overdue' depends on today's date and is always derived live.
  totalReceived Float    @default(0)
  balanceDue    Float    @default(0)

  notes         String   @default("")
  createdDate   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  entries       ReceivableEntry[]

  @@index([customerId])
  @@index([bookingId])
  @@index([tripId])
  @@map("receivables")
}

model ReceivableEntry {
  id           String     @id
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amount       Float
  paymentDate  String
  paymentMode  String
  reference    String?
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([receivableId])
  @@map("receivable_entries")
}

enum FinancialTransactionType {
  RECEIVABLE
  PAYMENT_RECEIVED
  PAYABLE
  PAYMENT_SENT
  GST_OUTPUT
  GST_INPUT
  REFUND
  ADJUSTMENT
}

model FinancialTransaction {
  id              String                   @id @default(cuid())
  type            FinancialTransactionType
  sourceType      String
  sourceId        String
  customerId      String?
  vendorId        String?
  tripId          String?
  bookingId       String?
  amount          Float
  gstAmount       Float                    @default(0)
  taxableAmount   Float                    @default(0)
  description     String                   @default("")
  transactionDate String
  paymentMode     String?
  reference       String?
  createdBy       String?
  createdAt       DateTime                 @default(now())

  @@index([customerId])
  @@index([vendorId])
  @@index([tripId])
  @@index([bookingId])
  @@index([sourceType, sourceId])
  @@map("financial_transactions")
}

model Task {
  id            String   @id
  title         String
  description   String?
  priority      String   @default("medium")
  status        String   @default("pending")
  tripId        String?
  bookingId     String?
  customerId    String?
  dueDate       String?
  assignedTo    String?
  completedDate String?
  createdDate   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trip          Trip?    @relation(fields: [tripId], references: [id])

  @@map("tasks")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  title       String?
  description String
  entityType  String
  entityId    String
  userId      String?
  metadata    Json?
  timestamp   String
  date        String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([date])
  @@index([action])
  @@map("activity_logs")
}

model Communication {
  id         String   @id @default(cuid())
  type       String   // 'whatsapp' | 'email'
  recipient  String
  subject    String?
  entityType String
  entityId   String
  userId     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([type])
  @@map("communications")
}

model Reminder {
  id        String   @id @default(cuid())
  tripId    String?
  type      String
  priority  String
  message   String
  dueDate   String
  sent      Boolean  @default(false)
  sentAt    String?
  createdAt DateTime @default(now())

  @@map("reminders")
}

model Vendor {
  id            String          @id
  name          String
  companyName   String?
  type          String
  contactPerson String?
  phone         String
  whatsapp      String?
  email         String?
  destinations  Json            @default("[]")
  paymentTerms  String?
  bankDetails   Json            @default("{}")
  gstNumber     String?
  notes         String?
  isActive      Boolean         @default(true)
  createdDate   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  payments      VendorPayment[]

  @@index([type])
  @@map("vendors")
}

model VendorPayment {
  id          String   @id
  vendorId    String
  vendorName  String
  tripId      String?
  tripName    String?
  description String?
  totalCost   Float    @default(0)
  advancePaid Float    @default(0)
  outstanding Float    @default(0)
  isPaid      Boolean  @default(false)
  paidDate    String?
  dueDate     String?
  notes       String?
  createdDate String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([tripId])
  @@map("vendor_payments")
}

model Quotation {
  id              String          @id
  quotationNumber String          @unique
  customerId      String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  destination     String
  startDate       String?
  endDate         String?
  pax             Int             @default(1)
  status          String          @default("draft")
  approvalStatus  String          @default("DRAFT")
  approvalComment String?
  submittedBy     String?
  submittedAt     String?
  approvedBy      String?
  approvedAt      String?
  notes           String?
  termsAndConds   String?
  validUntil      String?
  inclusions      String?
  exclusions      String?
  paymentPolicy   String?
  gstRate         Float           @default(0)
  gstMode         GstMode         @default(EXCLUDED)
  gstAmount       Float           @default(0)
  taxableAmount   Float           @default(0)
  totalCost       Float           @default(0)
  totalSelling    Float           @default(0)
  grossProfit     Float           @default(0)
  marginPct       Float           @default(0)
  convertedTripId String?
  convertedAt     String?
  createdDate     String
  sentAt          String?
  acceptedAt      String?
  rejectedAt      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           QuotationItem[]

  @@index([status])
  @@index([approvalStatus])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  category     String
  description  String
  quantity     Int       @default(1)
  costPrice    Float     @default(0)
  sellingPrice Float     @default(0)
  vendorId     String?
  vendorName   String?
  totalCost    Float     @default(0)
  totalSelling Float     @default(0)
  grossProfit  Float     @default(0)
  marginPct    Float     @default(0)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Itinerary {
  id               String         @id
  tripId           String?
  quotationId      String?
  title            String
  destination      String
  customerName     String
  customerPhone    String?
  customerEmail    String?
  startDate        String?
  endDate          String?
  pax              Int            @default(1)
  status           String         @default("draft")
  notes            String?
  emergencyContact String?
  template         String?
  passengerIds     Json           @default("[]")
  createdDate      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  days             ItineraryDay[]

  @@index([tripId])
  @@index([quotationId])
  @@index([status])
  @@map("itineraries")
}

model ItineraryDay {
  id           String    @id @default(cuid())
  itineraryId  String
  dayNumber    Int
  date         String?
  title        String
  morning      String?
  afternoon    String?
  evening      String?
  hotelName    String?
  hotelAddress String?
  meals        Json      @default("[]")
  transfers    String?
  activities   Json      @default("[]")
  notes        String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  itinerary    Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@map("itinerary_days")
}

model Voucher {
  id               String   @id
  voucherNumber    String   @unique
  tripId           String?
  customerId       String?
  vendorId         String?
  type             String
  status           String   @default("draft")
  issueDate        String?
  customerName     String
  customerPhone    String?
  guestNames       String?
  destination      String?
  hotelName        String?
  hotelAddress     String?
  hotelPhone       String?
  checkIn          String?
  checkOut         String?
  roomType         String?
  mealPlan         String?
  confirmationNo   String?
  nights           Int?
  pickupPoint      String?
  dropPoint        String?
  pickupDate       String?
  pickupTime       String?
  vehicleType      String?
  driverName       String?
  driverPhone      String?
  flightInfo       String?
  activityName     String?
  activityDate     String?
  activityTime     String?
  activityVenue    String?
  activityNotes    String?
  airline          String?
  flightNumber     String?
  pnr              String?
  departure        String?
  arrival          String?
  departureDate    String?
  arrivalDate      String?
  flightClass      String?
  visaType         String?
  country          String?
  entryType        String?
  validity         String?
  visaFee          Float?
  vendorName       String?
  vendorPhone      String?
  vendorEmail      String?
  pax              Int      @default(1)
  gstRate          Float    @default(0)
  gstMode          GstMode  @default(EXCLUDED)
  gstAmount        Float    @default(0)
  taxableAmount    Float    @default(0)
  totalPayable     Float?
  passengerIds     Json     @default("[]")
  notes            String?
  emergencyContact String?
  internalNotes    String?
  createdDate      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tripId])
  @@index([vendorId])
  @@index([status])
  @@index([type])
  @@map("vouchers")
}

model Passenger {
  id                    String   @id
  customerId            String?

  firstName             String
  lastName              String
  displayName           String?
  dateOfBirth           String?
  nationality           String?
  gender                String?

  passportNumber        String?
  passportIssueDate     String?
  passportExpiry        String?
  placeOfIssue          String?

  visaStatus            String?
  visaExpiry            String?
  visaCountry           String?
  visaType              String?

  frequentFlyerNumber   String?
  mealPreference        String?
  seatPreference        String?

  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelation     String?

  notes                 String?
  createdDate           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([customerId])
  @@index([passportNumber])
  @@map("passengers")
}

enum Role {
  ADMIN
  SALES
  OPERATIONS
  ACCOUNTS
}

enum GstMode {
  INCLUDED
  EXCLUDED
}
