// ============================================================
// GK TRAVELS CRM — Prisma Schema
// Local PostgreSQL (no Supabase, no multi-tenant)
//
// npx prisma migrate dev --name init   → first migration
// npx prisma generate                  → regenerate client
// npx prisma studio                    → visual DB browser
// npm run db:seed                      → seed admin user
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth ────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hash
  name      String
  role      String   @default("ADMIN")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─── Customer ────────────────────────────────────────────────

model Customer {
  id          String   @id
  name        String
  phone       String
  altPhone    String?
  email       String?
  address     String?
  city        String?
  preferences Json     @default("{}")
  notes       String?
  tripIds     Json     @default("[]")
  documents   Json     @default("[]")
  createdDate String
  sourceLeadId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customers")
}

// ─── Lead ────────────────────────────────────────────────────

model Lead {
  id           String   @id
  name         String
  phone        String
  email        String?
  source       String
  destination  String   @default("")
  travelDate   String?
  pax          Int      @default(1)
  budget       Float?
  tripType     String   @default("")
  status       String   @default("new")
  priority     String   @default("medium")
  notes        String   @default("")
  followUpDate String?
  assignedTo   String?
  createdDate  String

  // Conversion audit
  convertedTripId     String?
  convertedCustomerId String?
  convertedAt         String?
  convertedBy         String?

  timeline  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

// ─── Trip ────────────────────────────────────────────────────

model Trip {
  id          String  @id
  customer    String
  phone       String  @default("")
  email       String?
  customerId  String?
  destination String
  type        String  @default("Leisure")
  pax         Int     @default(1)
  departure   String?
  returnDate  String?
  status      String  @default("draft")

  // Financial
  totalAmount  Float?
  gstRate      Float   @default(5)
  discount     Float   @default(0)
  gstAmount    Float   @default(0)
  totalPayable Float?
  paidAmount   Float   @default(0)
  balanceDue   Float   @default(0)
  supplierCost Float   @default(0)
  grossMargin  Float   @default(0)
  marginPct    Float   @default(0)

  // Operational
  visaStatus    String @default("pending")
  hotelStatus   String @default("pending")
  flightStatus  String @default("pending")
  checkInStatus String @default("not_due")

  notes       String  @default("")
  assignedTo  String?
  createdDate String
  createdBy   String?

  // Lead conversion
  sourceLeadId        String?
  convertedFromLeadId String?
  convertedAt         String?
  convertedBy         String?

  timeline  Json     @default("[]")
  itinerary Json     @default("[]")
  documents Json     @default("[]")

  payments Payment[]
  tasks    Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trips")
}

// ─── Booking ─────────────────────────────────────────────────

model Booking {
  id           String  @id
  type         String
  status       String  @default("pending")
  customerName String
  customerId   String?
  refId        String? // linked trip ID

  // Financial
  sellingPrice    Float?
  supplierCost    Float   @default(0)
  advance         Float   @default(0)
  supplierPaid    Float   @default(0)
  gstRate         Float   @default(0)
  gstAmount       Float   @default(0)
  totalPayable    Float?
  balanceDue      Float   @default(0)
  supplierPending Float   @default(0)
  grossMargin     Float   @default(0)
  marginPct       Float   @default(0)

  detail      Json     @default("{}")
  notes       String   @default("")
  createdDate String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}

// ─── Payment ─────────────────────────────────────────────────

model Payment {
  id         String  @id
  type       String  // 'customer' | 'supplier'
  tripId     String?
  trip       Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  bookingId  String?
  customer   String?
  customerId String?
  amount     Float
  method     String
  date       String
  paidDate   String?
  status     String  // 'pending' | 'received' | 'paid'
  reference  String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

// ─── Task ────────────────────────────────────────────────────

model Task {
  id            String  @id
  title         String
  description   String?
  priority      String  @default("medium")
  status        String  @default("pending")
  tripId        String?
  trip          Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  bookingId     String?
  customerId    String?
  dueDate       String?
  assignedTo    String?
  completedDate String?
  createdDate   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

// ─── Activity Log ────────────────────────────────────────────

model ActivityLog {
  id         String  @id @default(cuid())
  type       String
  message    String
  entityType String
  entityId   String
  userId     String?
  timestamp  String
  date       String
  before     Json?
  after      Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([date])
  @@map("activity_logs")
}

// ─── Reminder ────────────────────────────────────────────────

model Reminder {
  id       String  @id @default(cuid())
  tripId   String?
  type     String
  priority String
  message  String
  dueDate  String
  sent     Boolean @default(false)
  sentAt   String?

  createdAt DateTime @default(now())

  @@map("reminders")
}

// ─── Vendor ──────────────────────────────────────────────────

model Vendor {
  id            String  @id
  name          String                 // trade / display name
  companyName   String?
  type          String                 // hotel | transport | activity | guide | visa | miscellaneous
  contactPerson String?
  phone         String
  whatsapp      String?
  email         String?
  destinations  Json    @default("[]") // string[] — destinations this vendor serves
  paymentTerms  String?
  bankDetails   Json    @default("{}") // { accountNo, ifsc, bankName, accountHolder }
  gstNumber     String?
  notes         String?
  isActive      Boolean @default(true)
  createdDate   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments VendorPayment[]

  @@index([type])
  @@map("vendors")
}

// ─── VendorPayment ───────────────────────────────────────────
// One record per vendor engagement on a trip (or standalone).

model VendorPayment {
  id          String  @id
  vendorId    String
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorName  String                   // denormalized for display
  tripId      String?
  tripName    String?                  // denormalized for display
  description String?
  totalCost   Float   @default(0)
  advancePaid Float   @default(0)
  outstanding Float   @default(0)     // stored = totalCost - advancePaid
  isPaid      Boolean @default(false)
  paidDate    String?
  dueDate     String?
  notes       String?
  createdDate String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([tripId])
  @@map("vendor_payments")
}

// ─── Quotation ───────────────────────────────────────────────

model Quotation {
  id              String  @id                  // Q-2025-0001
  quotationNumber String  @unique              // same as id — human-readable
  customerId      String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  destination     String
  startDate       String?
  endDate         String?
  pax             Int     @default(1)
  status          String  @default("draft")    // draft | sent | accepted | rejected | expired

  notes          String?
  termsAndConds  String?
  validUntil     String?

  // Computed financial summary (recalculated from items every save)
  totalCost      Float   @default(0)
  totalSelling   Float   @default(0)
  grossProfit    Float   @default(0)
  marginPct      Float   @default(0)

  // Conversion audit
  convertedTripId String?
  convertedAt     String?

  createdDate String
  sentAt      String?
  acceptedAt  String?
  rejectedAt  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuotationItem[]

  @@index([status])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  category     String    // hotel | flight | transfer | activity | visa | insurance | misc
  description  String
  quantity     Int       @default(1)
  costPrice    Float     @default(0)
  sellingPrice Float     @default(0)
  vendorId     String?
  vendorName   String?

  // Computed per line (stored for reporting)
  totalCost    Float     @default(0)   // costPrice    * quantity
  totalSelling Float     @default(0)   // sellingPrice * quantity
  grossProfit  Float     @default(0)   // totalSelling - totalCost
  marginPct    Float     @default(0)   // grossProfit  / totalSelling * 100

  sortOrder    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@map("quotation_items")
}

// ─── Itinerary ───────────────────────────────────────────────

model Itinerary {
  id               String  @id                  // ITN-YYYY-NNNN
  tripId           String?
  quotationId      String?
  title            String
  destination      String
  customerName     String
  customerPhone    String?
  customerEmail    String?
  startDate        String?
  endDate          String?
  pax              Int     @default(1)
  status           String  @default("draft")    // draft | finalized
  notes            String?
  emergencyContact String?
  template         String?  // domestic | international | luxury | honeymoon | family
  createdDate      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days ItineraryDay[]

  @@index([tripId])
  @@index([quotationId])
  @@index([status])
  @@map("itineraries")
}

model ItineraryDay {
  id           String    @id @default(cuid())
  itineraryId  String
  itinerary    Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  dayNumber    Int
  date         String?   // Computed: startDate + (dayNumber - 1) days
  title        String    // e.g. "Day 1 — Arrival in Dubai"

  // Time slots
  morning      String?
  afternoon    String?
  evening      String?

  // Logistics
  hotelName    String?
  hotelAddress String?
  meals        Json      @default("[]")   // ('breakfast'|'lunch'|'dinner')[]
  transfers    String?

  // Activities
  activities   Json      @default("[]")   // string[]

  notes        String?
  sortOrder    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itineraryId])
  @@map("itinerary_days")
}

// ─── Voucher ─────────────────────────────────────────────────

model Voucher {
  id            String  @id                 // VCH-YYYY-NNNN
  voucherNumber String  @unique             // same as id
  tripId        String?
  customerId    String?
  vendorId      String?
  type          String                      // hotel | transfer | activity | flight | visa | general
  status        String  @default("draft")   // draft | issued | completed | cancelled
  issueDate     String?

  // Customer / guest
  customerName  String
  customerPhone String?
  guestNames    String?   // comma-separated list of guest names
  destination   String?

  // ── Hotel ────────────────────────────────────────────────
  hotelName      String?
  hotelAddress   String?
  hotelPhone     String?
  checkIn        String?
  checkOut       String?
  roomType       String?
  mealPlan       String?
  confirmationNo String?
  nights         Int?

  // ── Transfer ─────────────────────────────────────────────
  pickupPoint  String?
  dropPoint    String?
  pickupDate   String?
  pickupTime   String?
  vehicleType  String?
  driverName   String?
  driverPhone  String?
  flightInfo   String?   // flight number for airport transfers

  // ── Activity ─────────────────────────────────────────────
  activityName  String?
  activityDate  String?
  activityTime  String?
  activityVenue String?
  activityNotes String?

  // ── Flight ───────────────────────────────────────────────
  airline       String?
  flightNumber  String?
  pnr           String?
  departure     String?
  arrival       String?
  departureDate String?
  arrivalDate   String?
  flightClass   String?

  // ── Visa ─────────────────────────────────────────────────
  visaType    String?
  country     String?
  entryType   String?   // single / multiple
  validity    String?
  visaFee     Float?

  // ── Vendor info (denormalized for PDF) ───────────────────
  vendorName  String?
  vendorPhone String?
  vendorEmail String?

  // ── Common ───────────────────────────────────────────────
  pax              Int     @default(1)
  notes            String?
  emergencyContact String?
  internalNotes    String?

  createdDate String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([vendorId])
  @@index([status])
  @@index([type])
  @@map("vouchers")
}
