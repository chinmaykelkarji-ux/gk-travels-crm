# ============================================================
# GK TRAVELS CRM — Environment Variables
#
# LOCAL:      Copy to .env and fill in your values.
# PRODUCTION: Set all variables marked [REQUIRED] in the
#             Vercel dashboard → Settings → Environment Variables.
#
# NEVER commit .env to version control (.gitignore covers it).
# ============================================================

# ── Database ─────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string.
#
# Local dev:   postgresql://postgres:PASSWORD@localhost:5432/gktravels
# Production:  Get from Neon (neon.tech) or Supabase → Settings → Database
#
# Neon free tier: https://neon.tech  (no credit card, 0.5 GB)
# Supabase free tier: https://supabase.com  (500 MB, connection pooler included)
#
# IMPORTANT for Neon: append ?sslmode=require&pgbouncer=true&connect_timeout=10
# IMPORTANT for Supabase: use the "Connection pooling" URI (port 6543), not port 5432
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/gktravels"

# ── Express API ───────────────────────────────────────────────
# [LOCAL ONLY] Port for local development server.
# Vercel manages its own ports — this is ignored in production.
PORT=3001

# ── JWT ──────────────────────────────────────────────────────
# [REQUIRED] Must be a long, random secret.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="gkcrm_jwt_secret_change_me_2025_very_long_and_random_string"

# ── Node ─────────────────────────────────────────────────────
# [LOCAL ONLY] Vercel sets this to "production" automatically.
NODE_ENV=development

# ── Frontend origin (CORS) ────────────────────────────────────
# [PRODUCTION] Set to your Vercel deployment URL so the API
# accepts cookies and cross-origin requests from the frontend.
# Example: https://gk-travels-crm.vercel.app
#
# On Vercel full-stack (same domain): same-origin requests bypass
# CORS entirely, but setting this is still good practice.
FRONTEND_URL=https://your-app.vercel.app

# ── Default admin (local dev / first-run seeding) ─────────────
# [OPTIONAL] Override to create a different admin on first start.
# For production, run: npx prisma db seed  after deploying.
DEFAULT_ADMIN_EMAIL=chinmaykelkara@gmail.com
DEFAULT_ADMIN_NAME=Chinmay
DEFAULT_ADMIN_PASS=Chinmay#1015

# ── Auth bypass (deployment testing only) ─────────────────────
# [TEMPORARY] Set both to "true" on a Vercel preview deployment to skip the
# login screen and auto-authenticate as admin@gktravels.local (ADMIN role).
# BYPASS_AUTH      → read by the Express API at runtime
# VITE_BYPASS_AUTH → baked into the frontend bundle at build time (Vite)
# Both must be set together; either alone has no effect.
# Set to "false" or delete both variables to restore normal auth.
# REMOVE BEFORE PRODUCTION
BYPASS_AUTH=false
VITE_BYPASS_AUTH=false
