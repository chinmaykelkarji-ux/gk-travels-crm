# ============================================================
# GK TRAVELS CRM — Environment Variables
#
# LOCAL:      Copy to .env and fill in your values.
# PRODUCTION: Set all variables marked [REQUIRED] in the
#             Vercel dashboard → Settings → Environment Variables.
#
# NEVER commit .env to version control (.gitignore covers it).
# ============================================================

# ── Database ─────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string.
#
# Local dev:   postgresql://postgres:PASSWORD@localhost:5432/gktravels
# Production:  Get from Neon (neon.tech) or Supabase → Settings → Database
#
# Neon free tier: https://neon.tech  (no credit card, 0.5 GB)
# Supabase free tier: https://supabase.com  (500 MB, connection pooler included)
#
# IMPORTANT for Neon: append ?sslmode=require&pgbouncer=true&connect_timeout=10
# IMPORTANT for Supabase: use the "Connection pooling" URI (port 6543), not port 5432
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/gktravels"

# ── Express API ───────────────────────────────────────────────
# [LOCAL ONLY] Port for local development server.
# Vercel manages its own ports — this is ignored in production.
PORT=3001

# ── JWT ──────────────────────────────────────────────────────
# [REQUIRED] Long, random secret, minimum 32 characters. The API refuses to
# start without it — there is no fallback. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER commit a real value to this file.
JWT_SECRET=

# ── Node ─────────────────────────────────────────────────────
# [LOCAL ONLY] Vercel sets this to "production" automatically.
NODE_ENV=development

# ── Frontend origin (CORS) ────────────────────────────────────
# [PRODUCTION] Set to your Vercel deployment URL so the API
# accepts cookies and cross-origin requests from the frontend.
# Example: https://gk-travels-crm.vercel.app
#
# On Vercel full-stack (same domain): same-origin requests bypass
# CORS entirely, but setting this is still good practice.
FRONTEND_URL=https://your-app.vercel.app

# ── First-admin bootstrap (empty database only) ───────────────
# [OPTIONAL] Both EMAIL and PASS must be set, or the bootstrap is skipped
# entirely — there is no default password. Once the account exists these can
# be removed. For an existing deployment, use: npm run seed:users
# NEVER commit a real password to this file.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_PASS=

# ── WhatsApp Business API (BSP — Gupshup / AiSensy / Interakt) ──
# [OPTIONAL] Required for automated WhatsApp reminders (payment,
# departure, supplier confirmation alerts). If unset, sends are
# logged as failed in message_logs but never crash the worker.
WHATSAPP_BSP_URL=
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=
# Phone number (with country code, no +) that receives internal
# operations alerts, e.g. supplier confirmation alerts.
AGENCY_OWNER_PHONE=

# ── Agency details (used on quote PDFs) ───────────────────────
# [OPTIONAL] Shown on sales quote PDF/print previews.
AGENCY_ADDRESS=
AGENCY_PHONE=
AGENCY_EMAIL=
AGENCY_GSTIN=
# Default terms & conditions text pre-filled into new sales quotes.
DEFAULT_TERMS=

# ── Email (SMTP) ─────────────────────────────────────────────
# [OPTIONAL] Required for outbound email (e.g. confirmations, vouchers).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── AI Layer (Gemini) ──────────────────────────────────────────
# [REQUIRED for AI features] Google Gemini API key (free tier).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Seed scripts (local / staging only) ──────────────────────
# [OPTIONAL] `npm run db:seed` creates an admin only when both are set.
# `npm run seed:users` needs SEED_USER_PASSWORD (min 12 chars). Neither
# script has a default password. Both refuse to run when NODE_ENV=production
# unless ALLOW_SEED_IN_PRODUCTION=yes.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASS=
SEED_USER_PASSWORD=
SEED_USER_DOMAIN=gktravels.local

# ── Background jobs ──────────────────────────────────────────
# [REQUIRED in production] Shared secret the scheduler presents as
# "Authorization: Bearer <secret>" to POST /api/jobs/tick (Vercel Cron sends
# it automatically when CRON_SECRET is set). Min 16 chars. Without it the
# endpoint returns 503 and no jobs run.
CRON_SECRET=
# Per-tick time budget in ms (keep below the function's maxDuration).
JOB_TICK_BUDGET_MS=20000

# ── Document storage (S3-compatible, e.g. Cloudflare R2) ─────
# [REQUIRED in production] Without these the document centre reports
# "not configured". Locally the API falls back to a .storage/ directory.
STORAGE_BUCKET=
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_LOCAL_DIR=.storage

# ── Identity data encryption (hard rule 7) ───────────────────
# [REQUIRED in production] 32 random bytes as 64 hex characters. Seals
# passport / Aadhaar / government-ID numbers (AES-256-GCM) and keys the
# blind index used for duplicate checks. Without it, production refuses to
# store identity numbers. Losing it makes stored numbers unreadable: keep a
# copy in a password manager. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
